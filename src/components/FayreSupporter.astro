---
import {withBase} from "../lib/urls";
---
<aside class="fayre-supporter" aria-label="The Glitter Tree support">
 <img src={withBase("/brand/glitter-tree.webp")} alt="The Glitter Tree" width="96" height="96" loading="lazy" />
 <div class="fayre-supporter__copy">
  <p class="fayre-supporter__eyebrow">In collaboration with</p>
  <h2>The Glitter Tree</h2>
  <p>Thank you to The Glitter Tree for supporting our Christmas Fayre. They will match our spend with a donation.</p>
 </div>
 <a class="button" href="https://theglittertree.com/" target="_blank" rel="noopener noreferrer"><span class="cta-label">Visit The Glitter Tree</span><svg class="external-link-icon cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/></svg><span class="visually-hidden"> (opens in a new tab)</span></a>
</aside>
<style>
.fayre-supporter{margin:2rem 0;padding:1.5rem;border-block:1px solid #b99a5b88;display:flex;gap:1.25rem;align-items:center;flex-wrap:wrap;color:#fff3d5}
.fayre-supporter img{border-radius:.5rem;width:5rem;height:5rem;flex:0 0 auto;background:#fff;object-fit:contain}
.fayre-supporter__copy{flex:1 1 20rem;min-width:0;overflow-wrap:anywhere}
.fayre-supporter__eyebrow{text-transform:uppercase;font:700 .72rem/1.5 var(--font-body);letter-spacing:.12em;color:#edcb83;margin:0 0 .25rem}
.fayre-supporter h2{font:500 1.5rem/1.3 Georgia,serif;margin:0;text-align:left;padding:0;color:#fff3d5}
.fayre-supporter h2:after{display:none}
.fayre-supporter__copy>p:last-child{margin:.6rem 0 0;line-height:1.6;max-width:42rem;text-wrap:balance}
.fayre-supporter a{display:inline-flex;gap:.65rem;align-items:center;justify-content:center;width:22rem;max-width:100%;min-height:3.5rem;border:1px solid #c9a65f;border-radius:1.75rem;padding:.7rem calc(1.3em + 1.8rem);background:#742f3c;color:#fff5e2;text-decoration:none;font-size:1rem;font-weight:700;overflow-wrap:anywhere;box-sizing:border-box}
.fayre-supporter a{position:relative;text-align:center;justify-content:center!important;gap:0!important;padding-inline:calc(1.3em + 1.8rem)!important}
.fayre-supporter a .cta-label{display:block;width:100%;min-width:0;text-align:center}
.fayre-supporter a svg.cta-icon{position:absolute!important;right:1rem!important;top:50%!important;transform:translateY(-50%)!important;translate:none!important;width:1.3em!important;height:1.3em!important;flex:0 0 auto;margin:0!important}
.fayre-supporter a:hover{background:#954052}.fayre-supporter a:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}
@media(max-width:47.99rem){.fayre-supporter{padding:1rem}.fayre-supporter__copy{flex:1 1 calc(100% - 7rem)}.fayre-supporter a{width:100%}}
@media(max-width:23rem){.fayre-supporter__copy{flex-basis:100%}}
/* Override the event page's stronger shared CTA padding without shifting the label. */
:global(.narnia-event .xmas-stage .fayre-supporter a.button),.fayre-supporter a.button{padding-left:calc(1.3em + 1.8rem)!important;padding-right:calc(1.3em + 1.8rem)!important}
:global(.narnia-event .xmas-stage .fayre-supporter a.button svg.cta-icon),.fayre-supporter a.button svg.cta-icon{top:50%!important;transform:none!important;translate:0 -50%!important}
</style>
