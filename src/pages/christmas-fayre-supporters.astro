---
import FayreNavigation from "../components/FayreNavigation.astro";
import NarniaHero from "../components/NarniaHero.astro";
import HomepageMobileIdentity from "../components/HomepageMobileIdentity.astro";
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/christmas.css";
import "../styles/fayre-supporters.css";
import FayrePageStyles from "../components/FayrePageStyles.astro";
import { withBase } from "../lib/urls";

const entry = await getEntry("events", "christmas-fayre-2026");
const event = entry?.data;
if (!event?.path || !event.signupUrl) throw new Error("Christmas Fayre content is missing");
const externalIcon = '<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/></svg>';
---
<BaseLayout image="/social/fayre-supporters-2026-v3.jpg" imageAlt="Fayre Supporters: logos of our sponsors Martin Flashman and Co, Ottershaw Christmas Tree Farm, The Glitter Tree, Galeta, W3 Colour, Moore's Tree Company and Giardina Family Butchers, with the Narnia-inspired woodland artwork." imageWidth={1200} imageHeight={630} title="Fayre Supporters" description="Thank you to the local businesses supporting the Ashley School Christmas Fayre: Martin Flashman and Co, Ottershaw Christmas Tree Farm, The Glitter Tree, Galeta, W3 Colour, Moore's Tree Company and Giardina Family Butchers." headerLogo="/brand/foa-logo-christmas-ivory.svg" footerLogo="/brand/foa-logo-christmas-ivory.svg" bodyClass="xmas-theme narnia-volunteering" preloadImage="/brand/narnia-hero-landscape.avif">
  <FayrePageStyles />
  <HomepageMobileIdentity label="The Friends of Ashley" logo="/brand/foa-logo-christmas-ivory.svg" />
  <div class="site-width fayre-supporters-hero">
      <NarniaHero event={event} supportersPage={true} snowfall={true} />
      <FayreNavigation current="supporters" />
    </div>
    <div class="site-width fayre-supporters">

      <section class="fayre-lead" aria-labelledby="supporter-martin">
        <p class="fayre-lead__label">Christmas Fayre sponsor</p>
        <div class="fayre-lead__well" data-reveal-box>
          <img class="reveal-on-load" src={withBase("/sponsors/martin-flashman.png")} alt="Martin Flashman and Co" width="1280" height="96" loading="lazy" decoding="async" />
        </div>
        <h2 id="supporter-martin" class="fayre-lead__name visually-hidden">Martin Flashman and Co</h2>
        <p class="fayre-lead__thanks">Thank you for sponsoring our Christmas Fayre.</p>
        <p class="fayre-lead__actions"><a class="button fayre-supporters__button" href="https://www.martinflashman.co.uk/" target="_blank" rel="noopener noreferrer"><span class="cta-label">Visit Martin Flashman and <span class="cta-tail">Co<span class="external-link-icon cta-icon supporter-icon" aria-hidden="true"><Fragment set:html={externalIcon} /></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a></p>
      </section>

      <h2 class="fayre-supporters__thanks-heading">With thanks to</h2>
      <div class="fayre-supporters__row">
        <section class="supporter-card" aria-labelledby="supporter-ottershaw">
          <div class="compact-body">
            <div class="supporter-card__logo">
              <img class="reveal-on-load" src={withBase("/sponsors/ottershaw-christmas-tree-farm.png")} alt="Ottershaw Christmas Tree Farm" width="300" height="422" loading="lazy" decoding="async" />
            </div>
            <div class="supporter-card__copy">
              <h3 id="supporter-ottershaw">Ottershaw Christmas Tree Farm</h3>
              <p>Thank you for donating two trees to our Christmas Fayre.</p>
            </div>
          </div>
        <p class="supporter-card__actions">
              <a class="button fayre-supporters__button" href="https://www.mauricemandry.com/" target="_blank" rel="noopener noreferrer"><span class="cta-label">Visit the farm's <span class="cta-tail">website<span class="external-link-icon cta-icon supporter-icon" aria-hidden="true"><Fragment set:html={externalIcon} /></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
            </p>
          </section>
        <section class="supporter-card" aria-labelledby="supporter-glitter">
          <div class="compact-body">
            <div class="supporter-card__logo supporter-card__logo--light">
              <img class="reveal-on-load" src={withBase("/brand/glitter-tree.webp")} alt="The Glitter Tree" width="96" height="96" loading="lazy" decoding="async" />
            </div>
            <div class="supporter-card__copy">
              <h3 id="supporter-glitter">The Glitter Tree</h3>
              <p>Thank you for supporting our Christmas Fayre. They will match our spend with a donation.</p>
            </div>
          </div>
        <p class="supporter-card__actions">
              <a class="button fayre-supporters__button" href="https://theglittertree.com/" target="_blank" rel="noopener noreferrer"><span class="cta-label">Visit The Glitter <span class="cta-tail">Tree<span class="external-link-icon cta-icon supporter-icon" aria-hidden="true"><Fragment set:html={externalIcon} /></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
            </p>
          </section>
        <section class="supporter-card" aria-labelledby="supporter-galeta">
          <div class="compact-body">
            <div class="supporter-card__logo supporter-card__logo--cream">
              <img class="reveal-on-load" src={withBase("/sponsors/galeta.svg")} alt="Galeta" width="127" height="31" loading="lazy" decoding="async" />
            </div>
            <div class="supporter-card__copy">
              <h3 id="supporter-galeta">Galeta</h3>
              <p>Thank you for donating our mince pies and cakes.</p>
            </div>
          </div>
        <p class="supporter-card__actions">
              <a class="button fayre-supporters__button" href="https://galeta.co.uk/" target="_blank" rel="noopener noreferrer"><span class="cta-label">Visit <span class="cta-tail">Galeta<span class="external-link-icon cta-icon supporter-icon" aria-hidden="true"><Fragment set:html={externalIcon} /></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
            </p>
          </section>
        <section class="supporter-card" aria-labelledby="supporter-w3colour">
          <div class="compact-body">
            <div class="supporter-card__logo supporter-card__logo--light">
              <img class="reveal-on-load" src={withBase("/sponsors/w3-colour.svg")} alt="W3 Colour" width="248" height="148" loading="lazy" decoding="async" />
            </div>
            <div class="supporter-card__copy">
              <h3 id="supporter-w3colour">W3 Colour</h3>
              <p>Thank you for supporting our Christmas Fayre with discounted printing.</p>
            </div>
          </div>
        <p class="supporter-card__actions">
              <a class="button fayre-supporters__button" href="https://www.w3colour.co.uk/" target="_blank" rel="noopener noreferrer"><span class="cta-label">Visit W3 <span class="cta-tail">Colour<span class="external-link-icon cta-icon supporter-icon" aria-hidden="true"><Fragment set:html={externalIcon} /></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
            </p>
          </section>
        <section class="supporter-card" aria-labelledby="supporter-moores">
          <div class="compact-body">
            <div class="supporter-card__logo supporter-card__logo--light">
              <img class="reveal-on-load" src={withBase("/sponsors/moores-tree-company.jpg")} alt="Moore's Tree Company" width="569" height="218" loading="lazy" decoding="async" />
            </div>
            <div class="supporter-card__copy">
              <h3 id="supporter-moores">Moore's Tree Company</h3>
              <p>Thank you for donating large cedar branches to our Christmas Fayre.</p>
            </div>
          </div>
        <p class="supporter-card__actions">
              <a class="button fayre-supporters__button" href="https://www.moorestreecompany.co.uk/" target="_blank" rel="noopener noreferrer"><span class="cta-label">Visit Moore's <span class="cta-tail">website<span class="external-link-icon cta-icon supporter-icon" aria-hidden="true"><Fragment set:html={externalIcon} /></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
            </p>
          </section>
        <section class="supporter-card supporter-card--monogram" aria-labelledby="supporter-giardina">
          <div class="compact-body">
            <div class="supporter-card__logo supporter-card__logo--monogram" aria-hidden="true">
              <img class="reveal-on-load" src={withBase("/sponsors/giardina-monogram.svg")} alt="" width="64" height="64" loading="lazy" decoding="async" />
            </div>
            <div class="supporter-card__copy">
              <h3 id="supporter-giardina">Giardina Family Butchers</h3>
              <p>Thank you for supporting our Christmas Fayre with discounted sausages and burgers.</p>
            </div>
          </div>
        <p class="supporter-card__actions">
              <a class="button fayre-supporters__button" href="https://www.instagram.com/giardina_butchers" target="_blank" rel="noopener noreferrer"><span class="cta-label">Giardina on <span class="cta-tail">Instagram<span class="external-link-icon cta-icon supporter-icon" aria-hidden="true"><Fragment set:html={externalIcon} /></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
            </p>
          </section>
      </div>

    </div>
</BaseLayout>
