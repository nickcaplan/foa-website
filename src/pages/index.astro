---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SponsorRibbon from "../components/SponsorRibbon.astro";
import FundraisingSummary from "../components/FundraisingSummary.astro";
import MobilePageHeading from "../components/MobilePageHeading.astro";
import { withBase } from "../lib/urls";
import { ordinalDateFormatter } from "../lib/dates";
const events = await getCollection("events");
const fireworks = events.find(({ id }) => id === "fireworks-2026")?.data;
if (!fireworks) throw new Error("Homepage event content is missing");
const latestNewsletter = (await getCollection("newsletters"))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.published!.getTime() - a.data.published!.getTime())[0]?.data;
const appeal = (await getCollection("fundraising")).find(({ id }) => id === "current-appeal")?.data;
if (!appeal) throw new Error("Homepage fundraising content is missing");
const fireworksDate = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" })(fireworks.start);
const timeFormatter = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/London" });
const fireworksSchedule = fireworks.schedule ?? [];
const scheduleStart = fireworksSchedule[0]?.time.getTime() ?? 0;
const scheduleSpan = (fireworksSchedule.at(-1)?.time.getTime() ?? 0) - scheduleStart;
const scheduleFraction = (time: Date) => (scheduleSpan > 0 ? (time.getTime() - scheduleStart) / scheduleSpan : 0.5);
// Conservative rendered-width estimates, shared by the image and its preload.
---
   <BaseLayout title="The Friends of Ashley" description="The Friends of Ashley, the PTA for Ashley C of E Primary School in Walton-on-Thames." bodyClass="homepage">
  <section class="hero">
    <div class="site-width hero-grid">
      <div class="hero-event">
       <div class="hero-copy">
          <MobilePageHeading>
            <p class="hero-next-event">Next event</p>
            <h1>Fireworks on the <em>Field.</em></h1>
          </MobilePageHeading>
          <p class="hero-when"><span class="hero-fact"><svg class="hero-fact-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg><strong>{fireworksDate}</strong></span><span class="hero-fact"><svg class="hero-fact-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg><strong>{fireworks.location!.replace(/ (\S+)$/, "\u00A0$1")}</strong></span></p><div class="event-timeline-wrap"><ol class="event-timeline">{fireworksSchedule.map((item) => <li style={`--at: ${scheduleFraction(item.time)}`}><time datetime={item.time.toISOString()}>{timeFormatter.format(item.time)}</time><span>{item.label}</span></li>)}</ol></div><div class="hero-actions">{fireworks.ticketUrl && <a class="button button--amber button--large" href={fireworks.ticketUrl} target="_blank" rel="noopener noreferrer"><span class="cta-label">Buy Fireworks <span class="cta-word">ticket<span class="cta-tail">s<span class="external-link-icon cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></span></a>}<a class="button button--primary button--large button--wide" href={withBase("/fireworks-volunteering/")}><span class="cta-label">Volunteer at <span class="cta-word">Firework<span class="cta-tail">s<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a>{fireworks.guide && <a class="button button--secondary button--large button--wide" href={withBase(fireworks.guide.path)} download={fireworks.guide.fileName}><span class="cta-label">Download the event <span class="cta-word">guid<span class="cta-tail">e<svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg></span></span><span class="visually-hidden"> (PDF{fireworks.guide.size ? `, ${fireworks.guide.size}` : ""})</span></span></a>}</div>
       </div>
        <article class="event-feature event-feature--poster">
          <SponsorRibbon />
        </article>
      </div>
     <div class="quick-list hero-links">
     {latestNewsletter && <a class="quick-row" href={withBase("/newsletter/")}><span><h3>Read the latest newsletter</h3><p>{latestNewsletter.title}</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>}
     <a class="quick-row" href={withBase("/get-involved/")}><span><h3>Get involved</h3><p>Roles, meetings, class reps and ways to help.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
     </div>
    </div>
  </section>
  <section class="fundraising-update" aria-labelledby="fundraising-update-title">
    <div class="site-width">
      <FundraisingSummary appeal={appeal} />
    </div>
  </section>
</BaseLayout>

