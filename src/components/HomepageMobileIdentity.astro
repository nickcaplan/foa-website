---
import { withBase } from "../lib/urls";

interface Props { label?: string; logo?: string; }
const { label = "The Friends of Ashley homepage", logo = "/brand/foa-logo-ivory.svg" } = Astro.props;
---
<div class="homepage-mobile-identity" aria-label={label}>
  <a class="homepage-mobile-identity__home" href={withBase("/")} aria-label="The Friends of Ashley home">
    <img src={withBase(logo)} alt="" width="44" height="44" />
    <p><span class="homepage-mobile-identity-prefix">The Friends of</span> Ashley PTA</p>
  </a>
</div>
<style is:inline>
  .homepage-mobile-identity { display: none; }
  @media (max-width: 63.99rem) {
    .homepage-mobile-identity { display: block; padding: 1rem calc(3rem + 16px) 1rem 0; position: relative; margin-inline: auto; width: calc(100% - 2rem); color: var(--heading); }
    .homepage-mobile-identity__home { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; color: inherit; text-decoration: none; }
    .homepage-mobile-identity img { width: 3rem; height: 3rem; flex: none; }
    .homepage-mobile-identity p { margin: 0; font-family: Georgia, serif; font-size: 1.5rem; font-weight: 700; line-height: 1.15; overflow-wrap: normal; word-break: normal; flex: 1; min-width: min(5.5em, 100%); }
  }
  @media (max-width: 63.99rem) {
    .homepage-mobile-identity-prefix { display: block; font-family: var(--font-body, system-ui, sans-serif); font-size: .52em; line-height: 1.5; letter-spacing: .09em; text-transform: uppercase; }
  }
  @media (max-width: 20rem) {
    .homepage-mobile-identity { padding-inline-end: 64px; }
  }
</style>
