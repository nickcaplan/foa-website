 .narnia-event .xmas-stage .xmas-stalls-cta .button{width:100%;max-width:none}
}
</style>
<style is:inline>
@media(max-width:47.99rem){
.narnia-event .xmas-stage .narnia-landscape:before{background:#10232ce6}
}
.narnia-event .xmas-stage .narnia-landscape .button:has(.cta-icon){width:100%;max-width:22rem}
</style>
<style is:inline>
