---
import {withBase} from '../lib/urls';
import {ordinalDateFormatter,formatEventTimeRange} from '../lib/dates';
const {event,eventPage=false,homepage=false,volunteerPage=false}=Astro.props;
const signupUrl = event.signupUrl;
const volunteerPath = event.volunteeringPath ?? event.path+"#sign-up";
if (!signupUrl) throw new Error("Christmas Fayre sign-up URL is missing");
const date=ordinalDateFormatter({weekday:'long',timeZone:'Europe/London'})(event.start);
---
<section class="narnia-landscape" aria-label="Christmas Fayre" id={eventPage ? "sign-up" : undefined} data-homepage-christmas={homepage ? "" : undefined}>
<img class="narnia-landscape__art" src={withBase('/brand/narnia-hero-landscape.avif')} width="1280" height="720" alt="" loading="eager" fetchpriority="high" />
<div class="narnia-landscape__copy">
<h1 id="xmas-title">Christmas <em>Fayre</em>{volunteerPage && <> <span class="narnia-landscape__subtitle">Volunteering</span></>}</h1>
<p class="narnia-landscape__date">{date} · {volunteerPage ? formatEventTimeRange(event.start,event.end).replace(/(?<=\d)-(?=\d)/g,' - ') : formatEventTimeRange(event.start,event.end)}</p>
<p class="narnia-landscape__venue">{event.location}{!volunteerPage && <><br />{event.entry}</>}</p>
<a class="button" href={volunteerPage ? signupUrl : eventPage ? withBase(volunteerPath) : withBase(event.path)} target={volunteerPage ? '_blank' : undefined} rel={volunteerPage ? 'noopener noreferrer' : undefined}><span class="cta-label">{eventPage ? "Sign up to " : "Event "}<span class="cta-word">{eventPage ? "help" : "details"}<span class="cta-tail">{volunteerPage ? <span class="external-link-icon cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span> : <span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span>}</span></span>{volunteerPage && <span class="visually-hidden"> (opens JustSignup in a new tab)</span>}</span></a>
{homepage && <a class="button narnia-landscape__secondary" href={withBase(volunteerPath)}><span class="cta-label">Sign up to <span class="cta-word">help<span class="cta-tail"><span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></span></span></a>}
</div>
{homepage && <div class="narnia-landscape__footer"><span class="sponsor-ribbon"><img src={withBase('/sponsors/martin-flashman.jpeg')} alt="Martin Flashman and Co" width="225" height="33" loading="lazy" /></span></div>}
</section>
<style is:inline>.narnia-landscape{grid-column:1/-1;position:relative;isolation:isolate;width:100%;max-width:72rem;margin:0 auto 1rem;border:1px solid #b99a5b;overflow:hidden;border-radius:10px;background:#102d38;box-shadow:0 12px 30px #102d3825;color:#fff3d5}.narnia-landscape__art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.narnia-landscape:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#10232c18,#10232cc9 35%,#10232cbf 63%,#10232c18);z-index:-1}.narnia-landscape__copy{text-align:center;padding:5rem 1.5rem;max-width:42rem;margin:auto;min-height:34rem;display:flex;flex-direction:column;justify-content:center;align-items:center}.narnia-landscape h1{width:100%!important;max-width:none!important;text-align:center!important;background:none!important;-webkit-text-fill-color:currentColor!important;text-transform:none!important;overflow-wrap:normal!important;word-break:normal!important;font:500 clamp(2rem,4.5vw,4.5rem)/1.12 Georgia,serif;color:#fff3d5!important;margin:0 0 1.25rem;letter-spacing:-.025em}.narnia-landscape__subtitle{display:block;font-size:.48em;letter-spacing:.04em;margin-top:.65em}.narnia-landscape h1 em{display:block;color:#edcb83;font-weight:400}.narnia-landscape__date{font-size:1.05rem;font-weight:700;line-height:1.7;margin:0 0 1rem;color:#fff3d5}.narnia-landscape__venue{font-size:1rem;line-height:1.7;margin:0 0 1.75rem;color:#f4ead1}.narnia-landscape .button{background:#742f3c;color:#fff5e2;border:1px solid #c9a65f;font-size:1rem;padding:.8rem 1.5rem;white-space:normal;line-height:1.5}.narnia-landscape .button .external-link-icon{margin-left:.45em}.narnia-landscape .button:focus-visible,.narnia-landscape__footer a:focus-visible{outline:3px solid #fff3d5!important;outline-offset:4px}.narnia-landscape__footer{position:relative;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:1rem 2rem;padding:1rem;background:#102d38}.narnia-landscape__footer .sponsor-ribbon{display:block;width:min(100%,225px);margin:0;background:none;border:0}.narnia-landscape__footer .sponsor-ribbon img{display:block;width:100%;height:auto}.narnia-landscape__footer a{color:#fff3d5;text-decoration:none}.narnia-landscape .button{min-height:3.5rem;min-width:0;width:100%;max-width:22rem}.narnia-landscape .narnia-landscape__secondary{margin-top:.75rem;background:transparent;border:1px solid #c9a65f;color:#fff3d5}.narnia-landscape .narnia-landscape__secondary:hover{background:#fff3d514}@media(max-width:47.99rem){.narnia-landscape__art{position:relative;display:block;height:auto;aspect-ratio:16/9;object-fit:cover}.narnia-landscape:before{display:none}.narnia-landscape__copy{min-height:0;padding:1.75rem 1.25rem 2rem}.narnia-landscape h1{font-size:min(3rem,10vw)!important}.narnia-landscape__subtitle{display:block;font-size:.48em;letter-spacing:.04em;margin-top:.65em}.narnia-landscape h1 em{display:inline}.narnia-landscape__date{font-size:1rem}.narnia-landscape .button{width:100%;max-width:22rem}}</style>
