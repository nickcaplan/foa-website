---
import PosterHero from "../components/PosterHero.astro";
import PosterForest from "../components/PosterForest.astro";
import NarniaScene from "../components/NarniaScene.astro";
import christmasHomeStyles from "../styles/christmas-home.css?inline";
import HomepageMobileIdentity from "../components/HomepageMobileIdentity.astro";
import EventVisibilityInit from "../components/EventVisibilityInit.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FundraisingSummary from "../components/FundraisingSummary.astro";
import MobilePageHeading from "../components/MobilePageHeading.astro";
import { withBase } from "../lib/urls";
import { ukDateKey } from "../lib/event-visibility";
import { ordinalDateFormatter, formatEventTimeRange } from "../lib/dates";
const narniaPreview = Astro.props.narniaPreview === true;
const events = await getCollection("events");
const christmasPreview = Astro.props.christmasPreview === true;
const event = events.find(({ id }) => id === "christmas-fayre-2026")?.data;
if (!event?.contactEmail) throw new Error("Homepage Christmas Fayre content is missing");
const latestNewsletter = (await getCollection("newsletters"))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.published!.getTime() - a.data.published!.getTime())[0]?.data;
const appeal = (await getCollection("fundraising")).find(({ id }) => id === "current-appeal")?.data;
if (!appeal) throw new Error("Homepage fundraising content is missing");
const eventDate = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" })(event.start);
const titleParts = event.title.trim().split(/\s+/);
const titleEnd = titleParts.pop()!;
const titleLead = titleParts.join(" ");
const baseAwareChristmasStyles = christmasHomeStyles.replaceAll('url("/brand/', `url("${withBase("/brand/")}`);
const mailto = `mailto:${event.contactEmail}?subject=${encodeURIComponent(`Helping at the ${event.title}`)}`;
---
   <BaseLayout title="The Friends of Ashley" description="The Friends of Ashley, the PTA for Ashley C of E Primary School in Walton-on-Thames." bodyClass={narniaPreview ? "homepage narnia-preview" : "homepage"} noindex={christmasPreview || narniaPreview} homepage={christmasPreview}>

  <style is:inline set:html={baseAwareChristmasStyles} />
  {narniaPreview && <p class="site-width narnia-preview-label">Design preview only.</p>}
  <HomepageMobileIdentity />
  <section class="hero">
    <div class="site-width hero-grid">
      {narniaPreview ? <PosterHero event={event} /> : <div class="hero-event" data-homepage-christmas>
        {narniaPreview && <PosterForest />}
        <span class="christmas-home-tree" aria-hidden="true"></span>
       <div class="hero-copy">
          <MobilePageHeading>
            <h1><span class="christmas-home-kicker">The Ashley</span> {titleLead} <em>{titleEnd}</em></h1>
          </MobilePageHeading>
          <p class="hero-when"><span class="hero-fact"><svg class="hero-fact-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg><strong>{eventDate}<span class="relative-date relative-date--inline" data-event-date={ukDateKey(event.start)} hidden></span></strong></span><span class="hero-fact"><svg class="hero-fact-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg><strong>{event.location}</strong></span></p><p class="christmas-home-admission"><span class="hero-fact"><svg class="hero-fact-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg><strong>{formatEventTimeRange(event.start, event.end)}</strong></span><span class="christmas-home-price hero-fact"><svg class="hero-fact-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4V5z"></path><path d="M14 5v2m0 3v4m0 3v2"></path></svg><span>{event.entry}</span></span></p></div>
       <div class="hero-side">

        <article class="event-feature event-feature--poster christmas-home-art" aria-label="Christmas Fayre artwork and details">
          {narniaPreview ? <NarniaScene /> : <img class="christmas-home-wreath" src={withBase("/brand/foa-logo-christmas-home.webp")} alt="The Friends of Ashley Christmas wreath" width="1200" height="630" loading="eager" fetchpriority="high" />}
          <span class="sponsor-ribbon"><img src={withBase("/sponsors/martin-flashman.jpeg")} alt="Martin Flashman and Co" width="225" height="33" loading="lazy" /></span>
        <div class="hero-actions"><a class="button button--primary button--large christmas-home-details" href={withBase(event.path!)}><span class="cta-label">Event <span class="cta-word">detail<span class="cta-tail">s<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a>
        <a class="button button--amber button--large" href={withBase(event.path!) + "#sign-up"}><span class="cta-label">Sign up to <span class="cta-word">hel<span class="cta-tail">p<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a>
        <a class="button button--amber button--large christmas-home-email" href={mailto}><span class="cta-label">Email the <span class="cta-word">organiser<span class="cta-tail">s<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a>
          </div>
        </article>
       </div>
      </div>}
     <div class="quick-list hero-links">
     {latestNewsletter && <a class="quick-row" href={withBase("/newsletter/")}><span><h3>Read the latest newsletter</h3><p>{latestNewsletter.title}</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>}
     <a class="quick-row" href={withBase("/get-involved/")}><span><h3>Get involved</h3><p>Roles, meetings, class reps and ways to help.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
     </div>
    </div>
  </section>
  <noscript><div class="site-width"><p>Homepage event shown as of the last site update. <a href={withBase(event.path!)}>Christmas Fayre details</a> are always available.</p></div></noscript>
  <section class="fundraising-update" aria-labelledby="fundraising-update-title">
    <div class="site-width">
      <FundraisingSummary appeal={appeal} />
    </div>
  </section>
  {christmasPreview && <div class="site-width"><p><strong>Christmas homepage preview only.</strong> The live homepage remains unchanged pending approval and deployment.</p></div>}
  <EventVisibilityInit />
</BaseLayout>


<script>
  import { syncEventVisibility, syncRelativeDates } from "../lib/event-visibility";
  const update = () => { syncEventVisibility(); syncRelativeDates(); };
  update();
  window.setInterval(update, 60000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) update(); });
  window.addEventListener("pageshow", update);
</script>

{narniaPreview && <style is:inline>
.narnia-preview [data-homepage-christmas]{background:linear-gradient(120deg,#102837,#1d4250)!important;color:#f2eee3!important;border-color:#b69761!important}.narnia-preview [data-homepage-christmas] h1,.narnia-preview [data-homepage-christmas] h1 em,.narnia-preview .hero-fact{color:#f2eee3!important}.narnia-preview [data-homepage-christmas] .christmas-home-tree{display:none!important}.narnia-preview [data-homepage-christmas] .hero-copy{background:none!important}.narnia-preview [data-homepage-christmas] h1 em{color:#e5c887!important}.narnia-preview .christmas-home-art{background:transparent!important;box-shadow:none!important}.narnia-preview .hero-actions .button{font-size:1rem}.narnia-preview .hero-copy .mobile-page-heading{padding-top:0!important}
</style>}

{narniaPreview && <style is:inline>.homepage.narnia-preview .hero-event[data-homepage-christmas] h1 em{color:#e5c887!important}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-fact-icon{color:#e5c887!important}</style>}
{narniaPreview && <style is:inline>@media(max-width:47.99rem){.narnia-preview>main>.site-width:first-child{padding-right:4rem}.narnia-preview .homepage-mobile-identity p{max-width:none}}</style>}

{narniaPreview && <style is:inline>
.homepage.narnia-preview .hero-event[data-homepage-christmas]{display:block;position:relative;overflow:hidden;padding:2rem clamp(40px,13%,155px);background:radial-gradient(ellipse at top,#f6e9cb,#e4cc9b)!important;border:3px double #ad8a4d!important;color:#4c2d25!important}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-copy{max-width:38rem;margin:auto;text-align:center}.homepage.narnia-preview .hero-event[data-homepage-christmas] h1,.homepage.narnia-preview .hero-event[data-homepage-christmas] h1 em{color:#712b32!important;font-size:clamp(2rem,5vw,5rem)}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-fact{color:#4c2d25!important}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-fact-icon{color:#886834!important}.homepage.narnia-preview .hero-when,.homepage.narnia-preview .christmas-home-admission{justify-content:center;align-items:center!important}.homepage.narnia-preview .hero-side{position:relative;max-width:30rem;margin:1.5rem auto 0}.homepage.narnia-preview .winter-scene{display:none}.homepage.narnia-preview .sponsor-ribbon{max-width:18rem;margin:auto}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-copy:before{content:"Welcome to Narnia";display:block;margin-bottom:1rem;text-transform:uppercase;letter-spacing:.15em;font:600 .85rem Georgia,serif;color:#7c462c}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-copy h1{border-bottom:1px solid #b7975e;padding-bottom:1rem}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-actions .button{background:#712b32}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-actions .button:hover{background:#4f2027}
@media(max-width:47.99rem){.homepage.narnia-preview .hero-event[data-homepage-christmas]{padding-block:1.5rem}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-copy .mobile-page-heading-copy{width:100%}.homepage.narnia-preview .hero-when{align-items:center}.homepage.narnia-preview .hero-event[data-homepage-christmas] h1{font-size:clamp(1.8rem,7vw,3rem)}}
</style>}
{narniaPreview && <style is:inline>.homepage.narnia-preview .winter-scene{display:block!important;margin-top:0}.homepage.narnia-preview .winter-scene img{max-height:28rem}.homepage.narnia-preview .hero-event[data-homepage-christmas]{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);gap:2rem;align-items:center}.homepage.narnia-preview .hero-side{margin:0 auto;width:100%}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-copy h1{font-size:clamp(2rem,4.5vw,4.5rem)}@media(max-width:63.99rem){.homepage.narnia-preview .hero-event[data-homepage-christmas]{display:block}.homepage.narnia-preview .hero-side{margin-top:1.5rem}.homepage.narnia-preview .hero-event[data-homepage-christmas] h1{font-size:clamp(1.8rem,7vw,3rem)}}</style>}
{narniaPreview && <style is:inline>@media(max-width:63.99rem){.homepage.narnia-preview>main>.site-width:first-child{padding-right:4.5rem}.homepage.narnia-preview .poster-forest{display:none}.homepage.narnia-preview .hero-event[data-homepage-christmas]{padding-inline:1.25rem}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-copy{text-align:left}.homepage.narnia-preview .hero-when,.homepage.narnia-preview .christmas-home-admission{align-items:flex-start!important;justify-content:flex-start}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-fact{display:flex;align-items:center;gap:.65rem;text-align:left}.homepage.narnia-preview .hero-fact-icon{flex:0 0 1.2rem;width:1.2rem;height:1.2rem}.homepage.narnia-preview .hero-event[data-homepage-christmas] .hero-copy:before{text-align:center}}</style>}

{narniaPreview && <style is:inline>@media(max-width:63.99rem){.homepage.narnia-preview .narnia-preview-label{width:auto;max-width:none;margin-inline:1rem 5rem;padding-inline:0!important}}</style>}
