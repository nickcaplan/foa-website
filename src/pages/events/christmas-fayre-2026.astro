---
import PosterHero from "../../components/PosterHero.astro";
import PosterForest from "../../components/PosterForest.astro";
import NarniaScene from "../../components/NarniaScene.astro";
import SignupPreview from "../../components/SignupPreview.astro";
import MobilePageHeading from "../../components/MobilePageHeading.astro";
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChristmasBaubles from "../../components/ChristmasBaubles.astro";
import ChristmasTrees from "../../components/ChristmasTrees.astro";
import AddToCalendar from "../../components/AddToCalendar.astro";
import "../../styles/christmas.css";
import { withBase } from "../../lib/urls";
import { ordinalDateFormatter, formatEventTimeRange } from "../../lib/dates";

const narniaPreview = Astro.props.narniaPreview === true;
const signupOption = Astro.props.signupOption ?? "c";
const entry = await getEntry("events", "christmas-fayre-2026");
if (!entry?.data.helpAreas || !entry.data.contactEmail) throw new Error("Christmas Fayre content is missing");
const event = entry.data;
const whatsOn = event.whatsOn ?? [];
const helpAreas = event.helpAreas!;
const email = event.contactEmail!;
const dateFormatter = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" });
const mailto = `mailto:${email}?subject=${encodeURIComponent("Helping at the Christmas Fayre")}`;

const icons = {
  funzone: "M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zM8.500 8.500h.01M15.500 8.500h.01M12 12h.01M8.500 15.500h.01M15.500 15.500h.01",
  craft: "M6 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM20 4L8.100 15.900M14.500 14.500L20 20M8.100 8.100L12 12",
  cafe: "M17 8h1a4 4 0 0 1 0 8h-1M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4zM6 2v3M10 2v3M14 2v3",
  photo: "M4 8h3l2-3h6l2 3h3v11H4zM12 17a3.500 3.500 0 1 0 0-7 3.500 3.500 0 0 0 0 7z",
  tombola: "M4 11h16v9H4zM3 7h18v4H3zM12 7v13M12 7c-2 0-4-1-4-2.500S10.500 3 12 7zM12 7c2 0 4-1 4-2.500S13.500 3 12 7z",
  tokens: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7.500v9M9.500 10h4a1.500 1.500 0 0 1 0 3h-3a1.500 1.500 0 0 0 0 3H15",
  sparkle: "M12 3l1.800 5.200L19 10l-5.200 1.800L12 17l-1.800-5.200L5 10l5.200-1.800zM19 16l.8 2.200L22 19l-2.200.8L19 22l-.8-2.200L16 19l2.200-.8z",
};

const flakes = Array.from({ length: 28 }, (_, i) => ({
  side: i % 2,
  lane: ((i * 37 + 11) % 100) / 100,
  size: 10 + ((i * 5) % 9),
  duration: 11 + ((i * 7) % 10),
  delay: -((i * 3.300) % 20),
  y: (i * 29 + 7) % 100,
  alpha: 0.55 + ((i * 11) % 4) * 0.1,
}));

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  description: "A magical Christmas afternoon for the Ashley school community, organised by The Friends of Ashley.",
  startDate: event.start.toISOString(),
  ...(event.end ? { endDate: event.end.toISOString() } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: { "@type": "Place", name: event.location, address: { "@type": "PostalAddress", addressLocality: "Walton-on-Thames", addressCountry: "GB" } },
  organizer: { "@type": "Organization", name: "The Friends of Ashley", url: new URL(withBase("/"), Astro.site).href },
};
---
<BaseLayout noindex={true} title={event.title} description="Help host the Ashley Christmas Fayre: join a slot with your friends, no experience needed." image="/brand/foa-logo-christmas-og.png" headerLogo="/brand/foa-logo-christmas-ivory.svg" footerLogo="/brand/foa-logo-christmas-ivory.svg" bodyClass={narniaPreview ? "xmas-theme narnia-event-preview" : "xmas-theme"}>
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <div class="xmas-stage">
    <div class="xmas-snow" aria-hidden="true">
      {flakes.map((f) => <i style={`--side:${f.side};--lane:${f.lane};--y:${f.y}%;--size:${f.size}px;--dur:${f.duration}s;--delay:${f.delay}s;--alpha:${f.alpha}`}></i>)}
    </div>

    <section class="xmas-hero" aria-labelledby="xmas-title">
      <ChristmasBaubles placement="desktop" />
      <div class="site-width">
        {narniaPreview ? <><p class="poster-preview-note">Design preview only.</p><PosterHero event={event} eventPage={true} /></> : <div class="xmas-frame xmas-hero__frame">
          {narniaPreview && <PosterForest />}
          {narniaPreview && <p class="narnia-concept-note">Narnia hero concept. Design preview only.</p>}
          <MobilePageHeading logo="/brand/foa-logo-christmas-ivory.svg">
            <h1 id="xmas-title">{event.title}</h1>
            <ChristmasBaubles placement="mobile" />
              <p class="xmas-credit" slot="below-logo"><img src={withBase("/sponsors/martin-flashman-mark.png")} alt="Martin Flashman and Co" width="72" height="72" loading="lazy"></p>
          </MobilePageHeading>
          {narniaPreview && <NarniaScene />}
          <dl class="xmas-facts">
            <div><dt>When</dt><dd><span class="xmas-nowrap">{dateFormatter(event.start)},</span> <span class="xmas-nowrap">{formatEventTimeRange(event.start, event.end)}</span></dd></div>
            <div><dt>Where</dt><dd>{event.location}</dd></div>
            {event.entry && <div><dt>Entry</dt><dd>{event.entry}</dd></div>}
            {whatsOn.length > 0 && <div><dt>What’s on</dt><dd>{whatsOn.map((item, index) => <>{index > 0 && <br />}{item}</>)}</dd></div>}
            <div><dt>Led by</dt><dd>{event.lead?.split(/(?<=\)) and /).map((lead, index) => <>{index > 0 && <br />}{lead}</>)}</dd></div>
          </dl>
          <p class="xmas-actions"><a class="button button--amber button--large" href={mailto}><span class="cta-label">Email the Fayre <span class="cta-word">tea<span class="cta-tail">m<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a><AddToCalendar eventId={entry.id} /></p>
        </div>}
      </div>
    </section>

    <section class="xmas-section" aria-labelledby="xmas-areas-title">
      <div class="site-width">
        <h2 id="xmas-areas-title">Where we need friendly faces</h2>
        <p class="xmas-section__lead">Instead of assigning stalls to year groups, anyone across the school can join in anywhere. Sign up for a slot alongside your friends and help with whatever you’re best at. Right now we’re looking for helpers (pairs welcomed!) to host our key areas:</p>
        <ul class="xmas-areas">
          {helpAreas.map((area) => (
            <li class="xmas-area">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={icons[area.icon]}></path></svg>
              <span>{area.name}</span>
            </li>
          ))}
        </ul>
        <div class="xmas-notes">
          <h3>Good to know</h3>
          <ul class="xmas-points">
            <li><strong>Join in anywhere.</strong> Open to everyone at school.</li>
            <li><strong>Bring a friend.</strong> Friendly faces wanted; pairs welcome.</li>
            <li><strong>No experience needed.</strong> You won’t be doing it alone. We’ll help with everything on the day.</li>
          </ul>
        </div>
      </div>
    </section>

    <SignupPreview option={signupOption} />

    <section class="xmas-section xmas-section--last" aria-labelledby="xmas-contact-title">
      <div class="site-width xmas-narrow">
        <div class="xmas-frame xmas-contact">
          <div class="xmas-contact__copy">
            <h2 id="xmas-contact-title">Get in touch</h2>
            <p>Email the Christmas Fayre team or chat with the team in the playground if you have any questions about helping. Choose a slot using the sign-up section above.</p>
            <p class="xmas-actions"><a class="button button--amber button--large" href={mailto}><span class="cta-label">Email the Fayre <span class="cta-word">tea<span class="cta-tail">m<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a></p>
          </div>
          <ChristmasTrees />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

{narniaPreview && <style is:inline>
.narnia-event-preview .xmas-hero__frame{background:linear-gradient(120deg,#102837,#1d4250);color:#f2eee3}.narnia-event-preview .xmas-hero__frame .winter-scene{float:right;width:44%;margin:0 0 1.5rem 2rem}.narnia-event-preview .xmas-hero__frame:after{content:"";display:table;clear:both}.narnia-event-preview .narnia-concept-note{font:700 .8rem system-ui;letter-spacing:.1em;color:#e5c887}.narnia-event-preview .xmas-hero__frame h1{color:#e5c887}.narnia-event-preview .xmas-hero__frame dt,.narnia-event-preview .xmas-hero__frame dd{color:#f2eee3}.narnia-event-preview .xmas-hero__frame .xmas-facts{clear:both}.narnia-event-preview .xmas-hero .xmas-baubles{display:none}@media(max-width:47.99rem){.narnia-event-preview .xmas-hero__frame .winter-scene{float:none;width:100%;margin:1rem auto}}
</style>}

{narniaPreview && <style is:inline>.narnia-event-preview .xmas-hero__frame .winter-scene{float:none;width:min(100%,36rem);margin:1rem auto 2rem}.narnia-event-preview .xmas-hero__frame .winter-scene svg{max-height:20rem}</style>}
{narniaPreview && <style is:inline>
@media(max-width:47.99rem){.narnia-event-preview .xmas-hero__frame{padding-inline:16px}.narnia-event-preview .xmas-hero__frame .mobile-page-heading{display:flex;flex-direction:column;align-items:center;gap:1rem}.narnia-event-preview .xmas-hero__frame .mobile-page-heading h1{font-size:clamp(1.5rem,6vw,2.8rem);overflow-wrap:normal;word-break:normal;text-align:center;width:100%}.narnia-event-preview .xmas-hero__frame .mobile-page-heading img{max-width:80px;max-height:80px}.narnia-event-preview .narnia-concept-note{padding-right:60px}}
</style>}

{narniaPreview && <style is:inline>@media(max-width:47.99rem){.narnia-event-preview .xmas-hero__frame .mobile-page-heading-copy{width:100%;padding-top:0}.narnia-event-preview .xmas-hero__frame .mobile-page-heading-brand{width:80px}.narnia-event-preview .xmas-hero__frame .mobile-page-heading-copy h1{font-size:clamp(1.5rem,8cqi,2.8rem)!important}.narnia-event-preview .narnia-concept-note{font-size:12px;line-height:1.5}}</style>}

{narniaPreview && <style is:inline>.narnia-event-preview .xmas-hero__frame{position:relative;overflow:hidden;padding-inline:clamp(42px,13%,155px);background:radial-gradient(ellipse at top,#f6e9cb,#e4cc9b)!important;border:3px double #ad8a4d;color:#4c2d25}.narnia-event-preview .xmas-hero__frame h1{color:#712b32!important}.narnia-event-preview .xmas-hero__frame dt,.narnia-event-preview .xmas-hero__frame dd{color:#4c2d25!important}.narnia-event-preview .xmas-hero__frame .winter-scene{display:none}.narnia-event-preview .narnia-concept-note{color:#7c462c;letter-spacing:.08em}.narnia-event-preview .xmas-hero__frame .mobile-page-heading:before{content:"Welcome to Narnia";font:600 .85rem Georgia,serif;text-transform:uppercase;letter-spacing:.15em;color:#712b32;margin-bottom:1rem}.narnia-event-preview .xmas-hero__frame .xmas-facts{position:relative;border-top:1px solid #b7975e;padding-top:1.5rem;margin-top:2rem}@media(max-width:47.99rem){.narnia-event-preview .xmas-hero__frame .mobile-page-heading-brand{display:none}.narnia-event-preview .xmas-hero__frame .mobile-page-heading-copy h1{font-size:clamp(1.5rem,9cqi,2.8rem)!important}.narnia-event-preview .narnia-concept-note{padding-right:0}}</style>}
{narniaPreview && <style is:inline>.narnia-event-preview .xmas-hero__frame .winter-scene{display:block!important;max-width:25rem;margin:1.5rem auto}.narnia-event-preview .xmas-hero__frame .winter-scene img{max-height:32rem}</style>}
{narniaPreview && <style is:inline>.narnia-event-preview .xmas-hero__frame h1{-webkit-text-fill-color:#712b32!important;background:none!important;color:#712b32!important;text-shadow:none!important}</style>}
{narniaPreview && <style is:inline>@media(max-width:63.99rem){.narnia-event-preview .poster-forest{display:none}.narnia-event-preview .xmas-hero__frame{padding-inline:1.25rem}.narnia-event-preview .narnia-concept-note{padding-inline:0 3rem;text-align:left}}</style>}

{narniaPreview && <style is:inline>@media(max-width:47.99rem){.narnia-event-preview .xmas-hero__frame .mobile-page-heading-copy h1{font-size:min(1.5rem,7vw)!important;line-height:1.25;max-width:100%}.narnia-event-preview .narnia-concept-note{margin-right:2rem}}</style>}

{narniaPreview && <style is:inline>.poster-preview-note{padding:1rem 5rem 1rem 0;color:#f3ead3;font-size:.85rem;max-width:56rem;margin:auto}</style>}
