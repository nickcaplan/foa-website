---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { withBase } from "../../lib/urls";
---
<BaseLayout title="Fireworks on the Field has finished" description="The 2026 Fireworks on the Field event has finished. Find current Friends of Ashley events.">
  <PageHero eyebrow="Past event" title="Fireworks on the Field has finished" intro="Thank you to everyone who came along and helped make the evening possible." />
  <section class="content-section"><div class="site-width">
    <p>The 2026 event information, ticket sales and volunteer sign-ups have been retired.</p>
    <p><a class="button button--primary" href={withBase("/events/christmas-fayre-2026/")}>Christmas Fayre details</a></p>
    <p><a href={withBase("/whats-on/")}>See what's on at Ashley</a></p>
  </div></section>
</BaseLayout>
