---
const { option = "c" } = Astro.props;
const url = "https://justsignup.io/s/uhyd1u3wq4";
---
<section id="sign-up" class="signup-demo site-width" aria-labelledby="signup-heading">
 <p class="eyebrow">Design preview only</p>
 <h2 id="signup-heading">Sign up to help</h2>
 <p>Choose an area and a slot alongside your friends.</p>
 {option === "loaded" && <p>Preview only: the live JustSignup board below loads automatically. Please do not submit test sign-ups.</p>}
 <nav aria-label="Compare sign-up options"><a href="/preview/signup-a/">A: Simple embed</a> · <a href="/preview/signup-b/">B: Framed embed</a> · <a href="/preview/signup-c/">C: Link only</a></nav>
 {option === "c" ? <div class="signup-card"><h3>A little time. A big difference.</h3><p>See the available slots and sign up on JustSignup.</p><a class="button button--amber" href={url} target="_blank" rel="noopener noreferrer">Sign up to <span class="cta-tail">help<span class="external-link-icon" aria-hidden="true">↗</span></span><span class="visually-hidden"> (opens in a new tab)</span></a></div> : <div class:list={["signup-embed", {"signup-embed--framed": (option === "b" || option === "loaded")}]}>
 {(option === "b" || option === "loaded") && <header><h3>Find your place at the Fayre</h3><p>Live slots, provided by JustSignup. Its page stays in its own light theme.</p></header>}
 {option !== "loaded" && <><p>Loading this form connects to JustSignup, a separate service with its own privacy policy. This preview does not load it until you choose below.</p>
 <button class="button button--amber" data-load-signup>Load the sign-up form</button></>}
 <iframe data-signup-frame src={option === "loaded" ? url + "?embed=1" : undefined} data-src={url + "?embed=1"} title="Ashley School's Narnia Christmas Fayre volunteer sign-up" style="width:100%;border:0;min-height:700px" loading={option === "loaded" ? "eager" : "lazy"} hidden={option !== "loaded"}></iframe>
 </div>}
 <p><a class="text-link" href={url} target="_blank" rel="noopener noreferrer">Open the sign-up page on <span class="cta-tail">JustSignup<span class="external-link-icon" aria-hidden="true">↗</span></span><span class="visually-hidden"> (opens in a new tab)</span></a></p>
 <p class="signup-note">Preview for discussion, not a finished release. The form is live: please do not submit test sign-ups.</p>
</section>
<script>
const frame = document.querySelector<HTMLIFrameElement>('[data-signup-frame]');
document.querySelector('[data-load-signup]')?.addEventListener('click', e => {if(frame){frame.src=frame.dataset.src!;frame.hidden=false;(e.currentTarget as HTMLElement).hidden=true;}});
addEventListener('message', e => { if (frame && e.origin === 'https://justsignup.io' && e.source === frame.contentWindow && e.data?.type === 'justsignup:height' && Number.isFinite(Number(e.data.height))) { const h=Number(e.data.height); if(h>0 && h<100000) frame.style.height=Math.max(700,h)+'px'; }});
</script>
<style>
.signup-demo{position:relative;z-index:2;padding-block:2rem;scroll-margin-top:2rem}.signup-demo h2{margin-bottom:.5rem}.signup-demo nav{display:flex;flex-wrap:wrap;gap:.6rem;margin-block:1.25rem}.signup-demo nav a{color:inherit;text-decoration:underline}.signup-card,.signup-embed--framed{border:1px solid #a58a54;border-radius:1rem;padding:clamp(1rem,4vw,2rem);background:#132e2d;color:#fff8e5}.signup-embed--framed header{border-bottom:1px solid #a58a54;margin-bottom:1rem;padding-bottom:1rem}.signup-embed--framed h3,.signup-card h3{color:#f3d797}.signup-demo iframe{display:block;background:#fafaf9;margin-top:1rem;border-radius:.5rem}.signup-demo iframe[hidden]{display:none}.signup-demo .button{margin:.5rem 0}.signup-note{font-size:.85rem;opacity:.85}
</style>
