---
import { withBase } from "../lib/urls";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import EventVisibilityInit from "../components/EventVisibilityInit.astro";
import { getEntry } from "astro:content";
import { eventVisibilityRules } from "../lib/event-lifecycle";
import { isHidden } from "../lib/event-visibility";
const sale = (await getEntry("events", "uniform-december-2026"))?.data;
if (!sale?.archiveFrom) throw new Error("December sale expiry is missing");
const expiresAt = sale.archiveFrom.toISOString();
const expired = isHidden(eventVisibilityRules(sale), Date.now());
const normalDescription = "Find pre-loved uniform from The Friends of Ashley, plus prices and contact details.";
---
<BaseLayout title="Pre-loved Uniform" image={expired ? "/brand/foa-logo-og.png" : "/social/uniform-christmas-jumpers-2026-v1.jpg"} imageAlt={expired ? "The Friends of Ashley logo." : "The Friends of Ashley logo beside a green, red and ivory Fair Isle Christmas jumper."} imageWidth={expired ? undefined : 1200} imageHeight={expired ? undefined : 630} description={expired ? normalDescription : "Find the next pre-loved uniform sale from The Friends of Ashley, including Christmas jumpers on Friday 4th December, plus uniform prices and contact details."}>
  <PageHero eyebrow="Pre-loved uniform" title="Buy or donate uniform." intro="Good uniform, passed on to another Ashley family.">
  </PageHero>
  <section class="content-section content-section--compact content-section--snug uniform-details"><div class="site-width split-layout split-layout--snug uniform-details-grid"><div class="christmas-sale" data-expires-at={expiresAt} hidden={expired}><div class="christmas-sale-top"><div class="christmas-sale-heading"><p class="eyebrow">Next sale</p><h2 class="editorial-heading">Friday 4th December</h2></div><img class="christmas-knit" src={withBase("/brand/christmas-jumper-fair-isle.svg")} width="500" height="470" alt="" aria-hidden="true" /></div><p class="section-copy">Christmas jumpers will be on sale alongside pre-loved uniform at the final sale of term.</p><p class="section-copy christmas-donations"><strong>Christmas jumpers wanted:</strong> in good condition, age 5 and up.</p><div class="sale-time">
    <svg class="sale-time-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
    <div><h3 class="sale-time-title">Sales start at <strong>15:25</strong></h3><p>In the school playground, weather permitting.</p></div>
  </div></div><div class="uniform-everyday" data-show-from={expiresAt} hidden={!expired}><p class="eyebrow">Pre-loved uniform</p><h2 class="editorial-heading">Uniform between sales</h2><p class="section-copy">Use the email or reservation form below to ask about uniform. We will share the next sale date when it is confirmed.</p></div><article class="info-card"><h2>Uniform prices and donations</h2><ul class="price-list"><li><span>New-logo items and coats</span><strong class="price-tag">£3 each</strong></li><li><span>All other items</span><strong class="price-tag">£1 each</strong></li></ul><p class="price-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M2 10h20"></path></svg>Card payments only</p><p class="donation-note">If you have any uniform which you would like to donate, please drop it in the green bins by the School Office - no torn items please!</p></article></div><div class="site-width uniform-cta"><a class="button button--primary button--large uniform-action" href="mailto:foapreloveduniform@gmail.com?subject=I%20would%20like%20to%20buy%20some...&amp;body=Please%20include%20sizes%20and%20quantities%20of%20each%20item%21"><span class="cta-label">Email the Preloved <span class="cta-word">tea<span class="cta-tail">m<svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span></span></span></a>
<a class="button button--amber button--large uniform-action" href="https://tinyurl.com/foapreloved" target="_blank" rel="noopener noreferrer"><span class="cta-label">Reserve via Google <span class="cta-word">For<span class="cta-tail">m<span class="external-link-icon cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></span></a></div></section>
  <EventVisibilityInit />
  <script>
    import { syncEventVisibility } from "../lib/event-visibility";
    const update = () => syncEventVisibility();
    update();
    window.setInterval(update, 60000);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) update(); });
    window.addEventListener("pageshow", update);
  </script>
</BaseLayout>

<style>
  :global(.view-hero:has(.uniform-action)) {
    container: uniform-hero / inline-size;
  }

  :global(.view-hero-inner:has(.uniform-action)) {
    grid-template-columns: minmax(0, 1fr);
  }

  :global(.view-hero-action:has(.uniform-action)) {
    width: 100%;
    grid-auto-rows: 1fr;
  }

  .christmas-sale {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--logo-gold);
    outline: 1px solid color-mix(in srgb, var(--logo-gold) 35%, transparent);
    outline-offset: -0.5rem;
    border-radius: var(--radius-md);
    background: linear-gradient(145deg, var(--green-dark), var(--sponsor-green));
    color: var(--christmas-sale-cream);
  }

  .christmas-sale-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .christmas-sale-heading { min-width: 0; }
  .christmas-sale-heading .editorial-heading { margin-bottom: 0; }
  .christmas-sale-top .eyebrow { color: var(--logo-gold); margin: 0 0 0.65rem; }
  .christmas-knit { width: clamp(5.25rem, 24vw, 8rem); height: auto; color: var(--christmas-knit-red); }
  .christmas-sale .editorial-heading { color: var(--christmas-sale-cream); font-size: clamp(2rem, 4vw, 3rem); }
  .christmas-sale .section-copy { color: var(--christmas-sale-cream); }
  .christmas-donations { border-top: 1px solid color-mix(in srgb, var(--logo-gold) 45%, transparent); padding-top: 1rem; }
  .christmas-donations strong { color: var(--logo-gold); }
  .christmas-sale .sale-time { background: transparent; border-color: var(--logo-gold); color: var(--christmas-sale-cream); }
  .christmas-sale .sale-time :is(h3, p, strong, svg) { color: var(--christmas-sale-cream); }

  .uniform-cta {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @container uniform-details (min-width: 64rem) {
    .uniform-cta {
      display: flex;
      flex-wrap: wrap;
    }
    .uniform-cta .uniform-action {
      flex: 1 1 auto;
      min-width: 0;
    }
  }

  .uniform-details {
    container: uniform-details / inline-size;
  }

  .split-layout.uniform-details-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .uniform-details .editorial-heading {
    overflow-wrap: anywhere;
  }

  @container uniform-details (min-width: 64rem) {
    .split-layout.uniform-details-grid {
      grid-template-columns: minmax(0, 0.65fr) minmax(0, 1fr);
    }
  }

  @media (min-width: 64rem) {
    @container uniform-hero (min-width: 55rem) {
      :global(.view-hero-inner:has(.uniform-action)) {
        grid-template-columns: minmax(0, 1fr) max-content;
      }

      :global(.view-hero-action:has(.uniform-action)) {
        width: max-content;
      }

      .button.uniform-action {
        padding-inline: 1.5rem;
      }
    }
  }
</style>
