@container(min-width:56em){
 .narnia-event .xmas-upcoming__grid>section[aria-labelledby="xmas-art-title"]>div{grid-template-columns:minmax(0,1.5fr) minmax(18rem,1fr);gap:0 2.5rem;justify-content:stretch}
 .narnia-event .xmas-followup:has(.narnia-event-details){grid-template-columns:minmax(0,1fr) minmax(0,2fr);align-items:start}
