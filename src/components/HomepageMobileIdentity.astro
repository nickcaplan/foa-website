---
import { withBase } from "../lib/urls";
---
<div class="homepage-mobile-identity" aria-label="The Friends of Ashley homepage">
  <img src={withBase("/brand/foa-logo-ivory.svg")} alt="" width="44" height="44" />
  <p>The Friends of Ashley</p>
</div>
<style is:inline>
  .homepage-mobile-identity { display: none; }
  @media (max-width: 63.99rem) {
    .homepage-mobile-identity { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; padding: 1rem calc(3rem + 16px) 1rem 0; margin-inline: auto; width: calc(100% - 2rem); color: var(--heading); }
    .homepage-mobile-identity img { width: 2.75rem; height: 2.75rem; flex: none; }
    .homepage-mobile-identity p { margin: 0; font-family: Georgia, serif; font-size: 1.1rem; font-weight: 700; line-height: 1.15; overflow-wrap: normal; word-break: normal; flex: 1; min-width: 7em; }
  }
  @media (max-width: 20rem) {
    .homepage-mobile-identity { padding-inline-end: 64px; }
  }
</style>
