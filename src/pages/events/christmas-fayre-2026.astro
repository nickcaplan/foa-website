---
import EventVisibilityInit from "../../components/EventVisibilityInit.astro";
import { eventVisibilityRules } from "../../lib/event-lifecycle";
import { isHidden } from "../../lib/event-visibility";
import HomepageMobileIdentity from "../../components/HomepageMobileIdentity.astro";
import NarniaHero from "../../components/NarniaHero.astro";
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChristmasTrees from "../../components/ChristmasTrees.astro";
import "../../styles/christmas.css";
import { withBase } from "../../lib/urls";

const entry = await getEntry("events", "christmas-fayre-2026");
if (!entry?.data.helpAreas || !entry.data.contactEmail) throw new Error("Christmas Fayre content is missing");
const event = entry.data;
const donation = await getEntry("events", "christmas-fayre-donations-day-2026");
if (!donation) throw new Error("Donations Day content is missing");
const donationRules = eventVisibilityRules(donation.data);
const helpAreas = event.helpAreas!;
if (!event.lead) throw new Error("Christmas Fayre leads are missing");
const leads = event.lead.split(/ and (?=[^()]*\()/);
const email = event.contactEmail!;
const mailto = `mailto:${email}?subject=${encodeURIComponent("Helping at the Christmas Fayre")}`;

const flakes = Array.from({ length: 28 }, (_, i) => ({
  side: i % 2,
  lane: ((i * 37 + 11) % 100) / 100,
  size: 10 + ((i * 5) % 9),
  duration: 11 + ((i * 7) % 10),
  delay: -((i * 3.300) % 20),
  y: (i * 29 + 7) % 100,
  alpha: 0.55 + ((i * 11) % 4) * 0.1,
}));

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  description: "A magical Christmas afternoon for the Ashley school community, organised by The Friends of Ashley.",
  startDate: event.start.toISOString(),
  ...(event.end ? { endDate: event.end.toISOString() } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: { "@type": "Place", name: event.location, address: { "@type": "PostalAddress", addressLocality: "Walton-on-Thames", addressCountry: "GB" } },
  organizer: { "@type": "Organization", name: "The Friends of Ashley", url: new URL(withBase("/"), Astro.site).href },
};
---
<BaseLayout socialTitle="Christmas Fayre | Saturday 5 December 2026 | Ashley School" socialDescription="Step into Narnia at Ashley School, Saturday 5 December, 12:00 - 15:00. Games, crafts, food and festive fun. Entry \u00a32; under 12s free." image="/social/christmas-fayre-2026-v1.jpg" imageAlt="Christmas Fayre, Saturday 5 December 2026, 12:00 - 15:00 at Ashley School, with the Narnia-inspired woodland artwork." imageWidth={1200} imageHeight={630} title={event.title} description="Help at the Ashley Christmas Fayre: join a slot with your friends, no experience needed." headerLogo="/brand/foa-logo-christmas-ivory.svg" footerLogo="/brand/foa-logo-christmas-ivory.svg" bodyClass="xmas-theme narnia-event">
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <HomepageMobileIdentity label="The Friends of Ashley" logo="/brand/foa-logo-christmas-ivory.svg" />
  <div class="xmas-stage">
    <div class="xmas-snow" aria-hidden="true">
      {flakes.map((f) => <i style={`--side:${f.side};--lane:${f.lane};--y:${f.y}%;--size:${f.size}px;--dur:${f.duration}s;--delay:${f.delay}s;--alpha:${f.alpha}`}></i>)}
    </div>

    <section class="xmas-hero" aria-labelledby="xmas-title">
      <div class="site-width">
        <NarniaHero event={event} eventPage={true} />
      </div>
    </section>

    <section id="donations-day" class="xmas-section" aria-labelledby="xmas-donations-title" data-expires-on={donationRules.expiresOn} hidden={isHidden(donationRules, Date.now())}>
      <div class="site-width">
        <h2 id="xmas-donations-title">Donations Day - <span class="xmas-donations-date">Friday 20th November</span></h2>
        <p class="xmas-section__lead">Classes will be assigned items to donate for prizes and the teacher's gift room.</p>
        <ul class="xmas-donations">
          <li><strong>Reception &amp; KS1: Drinks Tombola</strong><span>Bottles (alcohol or non-alcoholic)</span></li>
          <li><strong>Reception &amp; KS1: Children's Toy Tombola</strong><span>Small cuddly toys/games/toys, max value £5</span></li>
          <li><strong>KS2: Teacher's 'Socks &amp; Chocs' Gift Room</strong><span>Adult sized, new, socks for men &amp; women; new, sealed, chocolate boxes or boxed biscuits</span></li>
        </ul>
        <p class="xmas-donations__raffle"><strong>Raffle prizes:</strong> We are on the lookout for more raffle prizes - if your business or employer could donate something suitable, please let your class rep know.</p>
      </div>
    </section>

    <section class="xmas-section" aria-labelledby="xmas-art-title">
      <div class="site-width">
        <h2 id="xmas-art-title">Art Competition</h2>
        <p class="xmas-section__lead">Show us your lions, witches and snow queens! The theme is Narnia, and any medium is welcome. Deadline: Monday 30th November.</p>
        <p class="xmas-actions xmas-art-cta"><a class="button button--large" href={withBase('/christmas-fayre-art-competition/')}><span class="cta-label"><span class="cta-tail">Enter the art competition<svg data-cta-arrow="forward" class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></a></p>
      </div>
    </section>

    <section class="xmas-section" aria-labelledby="xmas-areas-title">
      <div class="site-width">
        <h2 id="xmas-areas-title">Where we need friendly faces</h2>
        <p class="xmas-section__lead">Instead of assigning stalls to year groups, anyone across the school can join in anywhere. Sign up for a slot alongside your friends and help with whatever you’re best at. Join the helpers at these activities (pairs welcome!):</p>
        <p class="xmas-section__lead xmas-help-roles" data-fayre-help-roles>{helpAreas.map(area => area.name).join('; ')}.</p>
        <p class="xmas-actions xmas-stalls-cta"><a class="button button--large" href={withBase(event.volunteeringPath ?? '/christmas-fayre-volunteering/')}><span class="cta-label"><span class="cta-tail">Volunteer<svg data-cta-arrow="forward" class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></a></p>
        <div class="xmas-notes">
          <h3>Good to know</h3>
          <ul class="xmas-points">
            <li><strong>Join in anywhere.</strong> Open to everyone at school.</li>
            <li><strong>Bring a friend.</strong> Friendly faces wanted; pairs welcome.</li>
            <li><strong>No experience needed.</strong> You won’t be doing it alone. We’ll help with everything on the day.</li>
          </ul>
        </div>
      </div>
    </section>

<style>
@media(max-width:47.99rem){.xmas-donations-date{display:block}}
.xmas-donations{list-style:none;margin:1.25rem 0 0;padding:1.25rem 1.5rem;display:grid;gap:.9rem;background:#173844;border:1px solid #b99a5b88;border-radius:.65rem}
.xmas-donations li{display:flex;flex-wrap:wrap;gap:.15rem 1.5rem;line-height:1.55}
.xmas-donations strong{color:#edcb83;flex:1 1 19rem;min-width:0}
.xmas-donations span{color:#fff3d5;overflow-wrap:anywhere;flex:2 1 28rem;min-width:0}
@container(max-width:20em){.xmas-donations{padding:1rem}}
.xmas-donations__raffle{margin:1rem 0 0;line-height:1.6;color:#f4ead1}.xmas-donations__raffle strong{color:#edcb83}

</style>
    <div class="site-width">
        <div class="narnia-event-details">
          <section class="fayre-leads" aria-labelledby="fayre-leads-title">
            <h2 id="fayre-leads-title">Led by</h2>
            <div class="fayre-leads__grid">{leads.map(lead=><p class="fayre-leads__card"><span>{lead}</span></p>)}</div>
          </section>
        </div>
    </div>

    <section class="xmas-section xmas-section--last" aria-labelledby="xmas-contact-title">
      <div class="site-width xmas-narrow">
        <div class="xmas-frame xmas-contact">
          <div class="xmas-contact__copy">
            <h2 id="xmas-contact-title">Get in touch</h2>
            <p>Email the Christmas Fayre team or chat with the team in the playground if you have any questions about helping. Use the sign-up button above to explore the volunteer activities, then choose your slot on JustSignup.</p>
            <p class="xmas-actions"><a class="button button--amber button--large" href={mailto}><span class="cta-label">Email the Fayre <span class="cta-word">tea<span class="cta-tail">m<span class="cta-icon" aria-hidden="true"><svg data-cta-arrow="forward" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></span></span></a></p>
          </div>
          <ChristmasTrees />
        </div>
      </div>
    </section>
  </div>
  <EventVisibilityInit />
  <script>
    import { syncEventVisibility } from "../../lib/event-visibility";
    syncEventVisibility();
    window.setInterval(() => syncEventVisibility(), 60000);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) syncEventVisibility(); });
  </script>
</BaseLayout>

<style is:inline>
.narnia-event .xmas-stage .site-width{width:min(calc(100% - 2rem),62rem)}@media(min-width:48rem){.narnia-event .xmas-stage .site-width{width:min(calc(100% - 3rem),62rem)}}.narnia-event .narnia-landscape{max-width:none}.narnia-event-details{max-width:52rem;margin:2rem auto 0;text-align:center}
</style>

<style is:inline>
@media(min-width:64rem){
.narnia-event-details{max-width:none;text-align:left}
}
</style>

<style is:inline>
.narnia-event .narnia-landscape__copy{min-height:0;padding:2rem 1.5rem;max-width:48rem}
.narnia-event .narnia-landscape h1{font-size:clamp(2rem,3.5vw,3rem);margin-bottom:.75rem}
.narnia-event .narnia-landscape h1 em{display:inline}
.narnia-event .narnia-landscape__date{margin-bottom:.5rem}
.narnia-event .narnia-landscape__venue{margin-bottom:1rem}
@media(max-width:47.99rem){
.narnia-event .narnia-landscape__art{position:absolute;inset:0;height:100%;aspect-ratio:auto;object-fit:cover}
.narnia-event .narnia-landscape:before{display:block;background:linear-gradient(90deg,#10232ccc,#10232cdd 35%,#10232ccc)}
.narnia-event .narnia-landscape h1{font-size:2rem!important}
.narnia-event .narnia-landscape__copy{padding:1.25rem 1rem}
}
</style>

<style is:inline>
.narnia-event .narnia-landscape__art{width:160%;max-width:none;left:0;right:auto;object-position:left center}
.narnia-event .narnia-landscape:before{display:block;background:linear-gradient(90deg,#10232c44,#10232cdd 42%,#10232ce6)}
@media(max-width:47.99rem){.narnia-event .narnia-landscape__art{width:180%;object-position:left center}}
</style>

<style is:inline>
.xmas-stalls-cta,.xmas-art-cta{margin:2rem auto;text-align:center}.xmas-stalls-cta .button,.xmas-art-cta .button{display:inline-flex;align-items:center;justify-content:center;gap:1rem;width:min(100%,22rem);min-height:3.5rem;padding:.8rem 1.5rem;background:#742f3c;border:1px solid #c9a65f;color:#fff5e2;font-size:1rem;line-height:1.5}.xmas-stalls-cta .button:focus-visible,.xmas-art-cta .button:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}.xmas-stalls-cta svg,.xmas-art-cta svg{flex:none}.xmas-art-cta .button{white-space:normal;text-align:left}.xmas-art-cta .cta-label,.xmas-art-cta .cta-tail{display:inline;white-space:normal;min-width:0}.xmas-art-cta .cta-tail svg{display:inline-block;vertical-align:middle;margin-left:.5rem}
</style>

<style is:inline>
@media(min-width:64rem){.narnia-event .xmas-section__lead{max-width:none}}
</style>

<style is:inline>
@media(max-width:47.99rem){
.narnia-event .xmas-hero{padding-bottom:0}
.narnia-event .xmas-hero+.xmas-section{padding-top:.75rem}
.narnia-event .xmas-hero+.xmas-section h2{margin-top:0}
}
</style>

<style is:inline>
@media(max-width:63.99rem){
.narnia-event .xmas-hero>.site-width{padding-top:0}
}

@media(min-width:64rem) and (max-width:79.99rem){.narnia-event .menu-toggle{top:calc(1rem + var(--introduction-logo-size)*.45 - 1.5rem)}}
</style>


<style is:inline>
.fayre-leads{margin:0}.narnia-event .fayre-leads h2{margin:0 0 .75rem;font:700 .85rem/1.4 var(--font-body,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase;color:#edcb83;text-align:left}.narnia-event .fayre-leads h2:after{display:none}.fayre-leads__grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.fayre-leads__card{margin:0;max-width:100%;padding:1.15rem;text-align:center;font:700 1.15rem/1.4 var(--font-display);color:var(--xm-gold-light);border:1px solid var(--xm-gold);border-radius:var(--radius-sm);background:linear-gradient(#17503ab3,#0f3a27b3);box-shadow:inset 0 0 0 4px #08241ae6,inset 0 0 0 5px var(--xm-gold-dim)}
@media(max-width:47.99rem){.fayre-leads__grid{grid-template-columns:1fr}}

</style>

<style is:inline>
.narnia-event .xmas-help-roles{max-width:none;margin-top:.75rem;line-height:1.65;text-wrap:pretty}
</style>

<style is:inline>
.narnia-event .xmas-stage .xmas-narrow{max-width:none}
</style>

<style is:inline>
@media(min-width:48rem){
.narnia-event .narnia-landscape__art{width:100%;left:0;right:0;object-position:center center}
.narnia-event .narnia-landscape:before{background:linear-gradient(90deg,#10232c33,#10232cdd 35%,#10232cdd 62%,#10232c88)}
}
</style>
