---
import FayreNavigation from "../components/FayreNavigation.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageMobileIdentity from '../components/HomepageMobileIdentity.astro';
import {withBase} from '../lib/urls';
import {getEntry} from 'astro:content';
import {ordinalDateFormatter} from '../lib/dates';
import '../styles/christmas.css';
import FayrePageStyles from '../components/FayrePageStyles.astro';
const deadlineEvent=await getEntry('events','christmas-fayre-art-deadline-2026');
if(!deadlineEvent) throw new Error('Art competition deadline record is missing');
const deadline=ordinalDateFormatter({weekday:'long',day:'numeric',month:'long',timeZone:'Europe/London'})(deadlineEvent.data.start);
const deadlineText=deadline;
// Fixed pseudo-random spread (prime-number strides) so the gutters look uneven but stay deterministic.
const SNOWFLAKE_COUNT = 20;
const flakes = Array.from({ length: SNOWFLAKE_COUNT }, (_, i) => ({
  side: i % 2, lane: ((i * 37 + 11) % 100) / 100,
  size: 6 + ((i * 5) % 7), duration: 10 + ((i * 7) % 9),
  delay: -((i * 3.3) % 18), y: (i * 29 + 7) % 95, alpha: .45 + ((i * 11) % 4) * .12,
}));
---
<BaseLayout socialTitle="Art Competition | Narnia theme | Ashley School" socialDescription="Show us your lions, witches and snow queens. Any medium welcome. Hand in your entry by Monday 30th November for the Ashley School Christmas Fayre Gallery." image="/social/art-competition-2026-v2.jpg" imageAlt="Art Competition, Narnia theme, deadline Monday 30th November, next to the Christmas Fayre woodland artwork framed on an easel." imageWidth={1200} imageHeight={630} title="Christmas Fayre Art Competition" description="Show us your lions, witches and snow queens. Enter the Ashley School Christmas Fayre Art Competition, theme Narnia, in any medium." headerLogo="/brand/foa-logo-christmas-ivory.svg" footerLogo="/brand/foa-logo-christmas-ivory.svg" bodyClass="xmas-theme narnia-volunteering art-comp" preloadImage="/brand/narnia-hero-landscape.avif">
 <HomepageMobileIdentity label="The Friends of Ashley" logo="/brand/foa-logo-christmas-ivory.svg" />
 <div class="site-width fayre-hero-shell">
  <section class="fayre-art-hero" aria-labelledby="fayre-art-title" data-hero-snow>
   <div class="xmas-snow" aria-hidden="true">
    {flakes.map(f => <i style={`--side:${f.side};--lane:${f.lane};--size:${f.size}px;--dur:${f.duration}s;--delay:${f.delay}s;--y:${f.y}%;--alpha:${f.alpha}`} />)}
    <div class="xmas-snow__bank" />
   </div>
   <div class="fayre-art-hero__copy">
    <p class="fayre-art-hero__eyebrow">Ashley School Christmas Fayre</p>
    <h1 id="fayre-art-title">Art Competition</h1>
    <p class="fayre-art-hero__theme">Narnia Theme</p>
    <div class="fayre-art-picture" aria-hidden="true"><img src={withBase('/brand/narnia-hero-landscape.avif')} width="1280" height="720" alt="" loading="eager" fetchpriority="high" /></div>
    <p class="fayre-art-hero__deadline"><span>Deadline</span><strong>{deadlineText}</strong></p>
    <span class="sponsor-ribbon fayre-art-hero__sponsor"><img class="reveal-on-load" src={withBase('/sponsors/martin-flashman.png')} alt="Martin Flashman and Co" width="1280" height="96" decoding="async" /></span>
   </div>
  </section>
 </div>
 <div class="site-width fayre-hero-shell"><FayreNavigation current="art" /></div>
 <div class="site-width">
  <p class="art-comp__credit"><svg aria-hidden="true" viewBox="0 0 24 24" width="12" height="12" fill="#c9a65f"><path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.5-6.3 4.5L8 13.8 2 9.2h7.6z"/></svg><span>Special thanks to Steph Cotela, who is organising the competition for the 10th year.</span><svg aria-hidden="true" viewBox="0 0 24 24" width="12" height="12" fill="#c9a65f"><path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.5-6.3 4.5L8 13.8 2 9.2h7.6z"/></svg></p>
 </div>
 <div class="site-width art-comp">
  <div class="art-comp__grid">
  <section class="art-comp__panel" aria-labelledby="art-comp-theme">
   <h2 id="art-comp-theme">Show us your lions, witches and snow queens!</h2>
   <p>Winter wonderland and Christmas themes are also welcome.</p>
   <p>Any and every Ashley student can enter - on your own, or in a group if you fancy. One entry per child. A4 is ideal for displaying at the Christmas Fayre Gallery, but anything is accepted: sculpture, knitting, textiles, drawings, paintings and more.</p>
  </section>
  <section class="art-comp__panel" aria-labelledby="art-comp-how">
   <h2 id="art-comp-how">How to enter</h2>
   <ul class="art-comp__steps">
    <li><strong>On the front of your artwork</strong><span>Class and year</span></li>
    <li><strong>On the back of your artwork</strong><span>Your name, and your consent as Y or N. Consent means you are happy for winning artworks to be displayed on the Ashley noticeboard or in the Martin Flashman window.</span></li>
    <li><strong>Hand it in by {deadlineText}</strong><span>Pop your entry in the box in the Hall (on the windowsill near the doors to outside), or leave it with the school office.</span></li>
   </ul>
  </section>
  <section class="art-comp__panel art-comp__panel--wide" aria-labelledby="art-comp-next">
   <h2 id="art-comp-next">Judging, prizes and getting your artwork back</h2>
   <ul class="art-comp__steps">
    <li><strong>Judging</strong><span>Steph Cotela is judging. Winners are announced at the Fayre, usually around 1 - 2pm.</span></li>
    <li><strong>Prizes</strong><span>Prizes will be something arty - think craft sets, colouring books or art sets.</span></li>
    <li><strong>On display, then back to you</strong><span>Every artwork will be on display at the Fayre, so every child gets to see their work. After the Fayre, pieces go back to the class teachers and can be collected on the next school day.</span></li>
   </ul>
  </section>
  </div>
  <p class="art-comp__back"><a class="button" href={withBase('/events/christmas-fayre-2026/')}><span class="cta-label">Back to the Christmas Fayr<span class="cta-tail">e<svg data-cta-arrow="forward" class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></a></p>
 </div>
 <FayrePageStyles />
</BaseLayout>
<style>
/* Easel legs under the canvas, desktop only where there is room. */
/* Uppercase COMPETITION is ~6.9em wide; cap the size against the hero copy
   container so the word always fits whole, at any text zoom (cqw is zoom-proof). */

.art-comp{padding-bottom:2.5rem;color:#fff3d5;container-type:inline-size}
.art-comp__panel{margin-top:1.25rem;padding:1.5rem;background:#173844;border:1px solid #b99a5b88;border-radius:.65rem}
.art-comp__panel--wide{grid-column:1/-1}
.art-comp__panel h2{margin:0 0 1rem;font:500 clamp(1.4rem,2.5vw,1.8rem)/1.25 Georgia,serif;color:#fff3d5}
.art-comp__panel p{margin:0 0 .75rem;font-size:1.05rem;line-height:1.7;color:#f4ead1}.art-comp__panel p:last-child{margin-bottom:0}
.art-comp__panel .art-comp__deadline-line{color:#edcb83;margin:0 0 1rem}
.art-comp__steps{list-style:none;margin:0;padding:0;display:grid;gap:.9rem}
.art-comp__steps li{display:grid;gap:.2rem;padding-top:.9rem;border-top:1px solid #b99a5b55;line-height:1.6}.art-comp__steps li:first-child{padding-top:0;border-top:0}
.art-comp__steps strong{color:#edcb83}.art-comp__steps span{color:#fff3d5;overflow-wrap:anywhere}
.art-comp__grid{display:grid;gap:0}@media(min-width:60rem){.art-comp__grid{grid-template-columns:1fr 1fr;gap:1.25rem;align-items:stretch}.art-comp__grid .art-comp__panel{margin-top:1.25rem}}
.art-comp__credit{margin:1rem auto 0;display:flex;align-items:center;justify-content:center;gap:.6rem;padding:.75rem 1rem;background:#173844;border:1px solid #c9a65f;border-radius:.65rem;color:#edcb83;font-size:.95rem;line-height:1.5;text-align:center;max-width:36rem}
.art-comp__back{margin:1.5rem auto 0;text-align:center}
.art-comp__back .button{display:inline-flex;align-items:center;justify-content:center;gap:1rem;width:min(100%,22rem);min-height:3.5rem;padding:.8rem 1.5rem;background:#742f3c;border:1px solid #c9a65f;color:#fff5e2;font-size:min(1rem,7.5vw);line-height:1.5;white-space:normal;text-align:left}
.art-comp__back .cta-label{display:inline;white-space:normal;min-width:0}.art-comp__back .cta-tail{display:inline;white-space:nowrap}.art-comp__back .cta-tail svg{display:inline-block;vertical-align:middle;margin-left:.5rem}.art-comp__back .button:hover{background:#954052}.art-comp__back .button:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}.art-comp__back svg{flex:none}
@container(max-width:20em){.art-comp__panel{padding:1rem}}

</style>
