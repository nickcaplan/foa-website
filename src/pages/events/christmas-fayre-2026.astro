@media(min-width:64rem){
.narnia-event-details{max-width:none;text-align:left}
}
</style>

<style is:inline>
.narnia-event .narnia-landscape__copy{min-height:0;padding:2rem 1.5rem;max-width:48rem}
.narnia-event .narnia-landscape h1{font-size:clamp(2rem,3.5vw,3rem);margin-bottom:.75rem}
.narnia-event .narnia-landscape h1 em{display:inline}
.narnia-event .narnia-landscape__date{margin-bottom:.5rem}
.narnia-event .narnia-landscape__venue{margin-bottom:1rem}
