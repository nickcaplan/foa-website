.narnia-event .xmas-stage .narnia-landscape:before{background:linear-gradient(90deg,#10232cf2,#10232cd9 35%,#10232c55 70%,#10232c33)}
.narnia-event .xmas-stage .narnia-landscape__copy{text-align:left;align-items:flex-start;margin-inline:0;padding-inline:1.5rem;max-width:48rem}
.narnia-event .xmas-stage .narnia-landscape h1{text-align:left!important}
.narnia-event .xmas-stage .narnia-landscape__footer{justify-content:flex-start;padding-inline:1.5rem}
.narnia-event .xmas-stage .narnia-landscape__footer .sponsor-ribbon img{margin-inline:0}
.narnia-event .xmas-stage .xmas-section__lead{max-width:72ch}
