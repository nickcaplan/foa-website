---
import {withBase} from "../lib/urls";
const {variant="a"}=Astro.props;
---
<aside class:list={["fayre-supporter",`fayre-supporter--${variant}`]} aria-label="The Glitter Tree support">
 <img src={withBase("/brand/glitter-tree.png")} alt="The Glitter Tree" width="96" height="96" loading="lazy" />
 <div class="fayre-supporter__copy">
  <p class="fayre-supporter__eyebrow">{variant==="a"?"With support from":"In collaboration with"}</p>
  <h2>The Glitter Tree</h2>
  {variant==="b"&&<p>Thank you to The Glitter Tree for supporting our Christmas Fayre. They will match our spend with a donation.</p>}
 </div>
 <a href="https://theglittertree.com/" target="_blank" rel="noopener noreferrer sponsored">Visit The Glitter Tree <svg class="external-link-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/></svg><span class="visually-hidden"> (opens in a new tab)</span></a>
</aside>
<style>
.fayre-supporter{margin:2rem 0;padding:1.25rem 1.5rem;border-top:1px solid #b99a5b88;border-bottom:1px solid #b99a5b88;display:flex;gap:1.25rem;align-items:center;flex-wrap:wrap;color:#fff3d5}
.fayre-supporter img{border-radius:.5rem;width:5rem;height:5rem;flex:0 0 auto;background:#fff;object-fit:contain}
.fayre-supporter__copy{flex:1 1 16rem;min-width:0;overflow-wrap:anywhere}.fayre-supporter__eyebrow{text-transform:uppercase;font:700 .72rem/1.5 var(--font-body);letter-spacing:.12em;color:#edcb83;margin:0 0 .25rem}.fayre-supporter h2{font:500 1.5rem/1.3 Georgia,serif;margin:0;text-align:left;padding:0;color:#fff3d5}.fayre-supporter h2:after{display:none}.fayre-supporter__copy>p:last-child:not(.fayre-supporter__eyebrow){margin:.6rem 0 0;line-height:1.6;max-width:42rem}
.fayre-supporter a{min-width:0;overflow-wrap:anywhere;display:inline-flex;gap:.65rem;align-items:center;border:1px solid #b99a5b88;border-radius:2rem;padding:.7rem 1rem;color:#edcb83;text-decoration:none;font-size:.9rem;font-weight:700}.fayre-supporter a:hover{background:#173844}.fayre-supporter a:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}.fayre-supporter a svg{flex:0 0 auto}.fayre-supporter--b{border:1px solid #b99a5b88;border-radius:.65rem;background:#102d38;padding:1.5rem}.fayre-supporter--b img{width:5rem;height:5rem}
@media(max-width:35rem){.fayre-supporter{gap:1rem;padding:1.25rem 1rem}.fayre-supporter__copy{flex-basis:calc(100% - 7rem)}.fayre-supporter a{max-width:100%;white-space:normal}.fayre-supporter--b .fayre-supporter__copy>p:last-child{font-size:.95rem}}
</style>
