---
import MobilePageHeading from "../components/MobilePageHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CryingLogo from "../components/CryingLogo.astro";
import { withBase } from "../lib/urls";
---
<BaseLayout title="Page not found" description="The requested page from The Friends of Ashley could not be found." noindex>
  <section class="content-section not-found-page">
    <div class="site-width empty-state">
      <CryingLogo />
      <div class="not-found-copy">
        <MobilePageHeading>
          <p class="eyebrow">404</p>
          <h1 class="editorial-heading">Oh no, we can't find that page.</h1>
        </MobilePageHeading>
        <p>It may have been moved or handed in to lost property. Here are some places that will help.</p>
        <div class="hero-actions"><a class="button button--primary button--large" href={withBase("/events/christmas-fayre-2026/")}>Christmas Fayre details</a></div>
        <nav class="not-found-links" aria-label="Explore The Friends of Ashley">
          <a class="quick-row" href={withBase("/whats-on/")}><h2 class="cta-label">What's <span class="cta-tail">On<span class="cta-icon" aria-hidden="true"><svg data-cta-arrow="forward" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></h2></a>
          <a class="quick-row" href={withBase("/fundraising/")}><h2 class="cta-label"><span class="cta-tail">Fundraising<span class="cta-icon" aria-hidden="true"><svg data-cta-arrow="forward" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></h2></a>
          <a class="quick-row" href={withBase("/get-involved/")}><h2 class="cta-label">Get <span class="cta-tail">Involved<span class="cta-icon" aria-hidden="true"><svg data-cta-arrow="forward" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></h2></a>
          <a class="quick-row" href={withBase("/uniform/")}><h2 class="cta-label"><span class="cta-tail">Uniform<span class="cta-icon" aria-hidden="true"><svg data-cta-arrow="forward" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></h2></a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
