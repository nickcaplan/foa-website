---
import MailIcon from "../components/MailIcon.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/urls";
import EventVisibilityInit from "../components/EventVisibilityInit.astro";
const members = (await getCollection("committee")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Committee" description="Meet the committee of The Friends of Ashley for 2026/27.">
  <PageHero eyebrow="The FOA team" title="Meet the committee." intro="Meet the 2026/27 committee and find out how to get involved." />
  <section class="content-section content-section--compact content-section--desktop-snug"><div class="site-width"><div class="committee-grid">{members.map(({ id, data }) => <article class:list={["member-card", data.imageClass]} data-show-before={id === "cristy-amponsah" ? "2026-11-28T00:00:00+00:00" : undefined}><div class="member-photo"><img src={withBase(`/${data.portrait}`)} alt={data.name} width={data.portraitWidth} height={data.portraitHeight} loading="lazy"></div><div class="member-details"><h2>{data.name}</h2><p>{data.role}</p></div></article>)}<article class="member-card member-card--vacancy"><div class="member-vacancy"><p class="member-vacancy-label">A seat is waiting</p><div class="member-vacancy-name"><span>Join</span><strong>the team</strong></div><p class="member-vacancy-copy">Agendas, minutes and paperwork - a light, termly role.</p><a href="mailto:thefriendsofashley@gmail.com?subject=The%20FOA%20Co-Secretary%20role&amp;body=Hello%20The%20FOA%20team%2C%0A%0AI%20would%20like%20to%20ask%20about%20the%20Co-Secretary%20role.%0A%0AThanks%2C"><span class="cta-label">Ask us about the <span class="cta-tail">role<MailIcon /></span></span></a></div><div class="member-details"><h2>Vacancy</h2><p>Co-Secretary</p></div></article><article class="member-card member-card--vacancy" hidden data-show-from="2026-11-28T00:00:00+00:00"><div class="member-vacancy"><p class="member-vacancy-label">A seat is waiting</p><div class="member-vacancy-name"><span>Join</span><strong>the team</strong></div><p class="member-vacancy-copy">Newsletters, the website and family updates - a light role.</p><a href="mailto:thefriendsofashley@gmail.com?subject=The%20FOA%20Co-Comms%20role&amp;body=Hello%20The%20FOA%20team%2C%0A%0AI%20would%20like%20to%20ask%20about%20the%20Co-Comms%20role.%0A%0AThanks%2C"><span class="cta-label">Ask us about the <span class="cta-tail">role<MailIcon /></span></span></a></div><div class="member-details"><h2>Vacancy</h2><p>Co-Comms</p></div></article></div><div class="committee-note" data-show-before="2026-11-28T00:00:00+00:00"><div><h2>There is room for you too.</h2><p>The FOA welcomes help from parents, carers and staff. The Co-Secretary role is currently vacant.</p></div><a class="button button--amber" href="mailto:thefriendsofashley@gmail.com?subject=The%20FOA%20Co-Secretary%20role&amp;body=Hello%20The%20FOA%20team%2C%0A%0AI%20would%20like%20to%20ask%20about%20the%20Co-Secretary%20role.%0A%0AThanks%2C"><span class="cta-label">Ask about the <span class="cta-tail">role<MailIcon /></span></span></a></div><div class="committee-note" hidden data-show-from="2026-11-28T00:00:00+00:00"><div><h2>There is room for you too.</h2><p>The FOA welcomes help from parents, carers and staff. The Co-Comms and Co-Secretary roles are currently vacant.</p></div><a class="button button--amber" href="mailto:thefriendsofashley@gmail.com?subject=The%20FOA%20committee%20roles&amp;body=Hello%20The%20FOA%20team%2C%0A%0AI%20would%20like%20to%20ask%20about%20a%20committee%20role.%0A%0AThanks%2C"><span class="cta-label">Ask about a <span class="cta-tail">role<MailIcon /></span></span></a></div></div></section>
<script is:inline>
(() => {
  /* At enlarged text the fixed-ratio vacancy box can no longer hold its
     content (media queries track the viewport, not the root font size), so
     grow the box and, if the pill alone is wider than a column, switch the
     grid to one column. Re-measured only when width or root font size change. */
  let lastW = -1, lastFS = -1;
  const update = (force) => {
    const fs = parseFloat(getComputedStyle(document.documentElement).fontSize);
    if (!force && fs === lastFS && innerWidth === lastW) return;
    lastFS = fs; lastW = innerWidth;
    // Reset the shared grid class once per grid, not per box: with two
    // vacancy cards in one grid, a per-box reset lets a later (hidden) card
    // wipe the roomy class an earlier card just added.
    document.querySelectorAll('.committee-grid').forEach((grid) => grid.classList.remove('committee-grid--roomy'));
    document.querySelectorAll('.member-vacancy').forEach((box) => {
      // Hidden cards (pre/post the vacancy date flip) have no layout;
      // measuring them would read 0s and corrupt the shared grid state.
      if (box.offsetParent === null) { box.classList.remove('member-vacancy--grown'); return; }
      const grid = box.closest('.committee-grid');
      const pill = box.querySelector('.member-vacancy-label');
      box.classList.remove('member-vacancy--grown');
      void box.offsetHeight;
      let grown = box.scrollHeight > box.clientHeight + 1;
      const pillW = pill ? pill.scrollWidth : 0;
      const name = box.querySelector('.member-vacancy-name');
      if (!grown && pill && name) {
        const pb = pill.getBoundingClientRect();
        const nb = name.getBoundingClientRect();
        grown = pb.bottom > nb.top + 2 && pb.right > nb.left + 2;
      }
      const pad = parseFloat(getComputedStyle(box).paddingLeft) * 2 + 4;
      const cardW = box.clientWidth;
      box.classList.toggle('member-vacancy--grown', grown);
      if (grown && grid && pillW > cardW - pad) grid.classList.add('committee-grid--roomy');
    });
  };
  new ResizeObserver(() => update(false)).observe(document.documentElement);
  addEventListener('resize', () => update(false));
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => update(true));
  update(true);
})();
</script>
<EventVisibilityInit />
</BaseLayout>
