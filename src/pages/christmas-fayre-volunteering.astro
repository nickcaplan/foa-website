---
import FayreNavigation from "../components/FayreNavigation.astro";
import {getEntry} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NarniaHero from '../components/NarniaHero.astro';
import HomepageMobileIdentity from '../components/HomepageMobileIdentity.astro';
import {withBase} from '../lib/urls';
import {remaining,totals,isSnapshot,type Snapshot} from '../lib/fireworks-availability';
import availabilityJson from '../../assets/fayre-availability.json';
import '../styles/christmas.css';
import FayrePageStyles from '../components/FayrePageStyles.astro';
const entry=await getEntry('events','christmas-fayre-2026');
const event=entry?.data;
if(!event?.signupActivities || !event.signupUrl || !event.loanSignupAnchor || !event.path || !event.contactEmail) throw new Error('Fayre volunteering content is missing');
const externalIcon='<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/></svg>';
// Render the last published counts at build so the first paint already shows them; the client script refreshes them.
const endedAt=Date.parse("2026-12-05T15:30:00+00:00");
const buildEnded=()=>Date.now()>=endedAt;
const snapshot:Snapshot=isSnapshot(availabilityJson)?availabilityJson:{};
const availability=event.signupActivities.map(activity=>{
  const a=snapshot.schema===1?snapshot.activities?.[activity.anchor]:undefined;
  const total=buildEnded()?{open:0,capacity:null}:totals(a,Date.now());
  const count=total===null?null:total.open;
  const state=buildEnded()?"ended":count===null?"unavailable":`${count}/${total?.capacity??""}`;
  return {code:activity.anchor,name:activity.displayName??activity.name,total,count,state,full:!buildEnded()&&count===0};
});
// Pin the hero to the existing Tokens activity, not the largest vacancy total.
const tokensCode="s-6b8rcxcfrk1lv003tvbq";
const tokensCount=buildEnded()?null:remaining(snapshot.schema===1?snapshot.activities?.[tokensCode]:undefined,Date.now());
const heroSummary=buildEnded()?"Volunteering has finished. Thank you to everyone who helped."
  :tokensCount===null?"Check JustSignup for Tokens places.":null;
const updatedTimes=availability.map(a=>snapshot.activities?.[a.code]?.checkedAt).filter((t):t is string=>!!t).map(Date.parse).filter(Number.isFinite);
const oldest=updatedTimes.length?Math.min(...updatedTimes):null;
const updatedText=buildEnded()||oldest===null?"":`Last updated ${new Intl.DateTimeFormat("en-GB",{timeZone:"UTC",hour:"2-digit",minute:"2-digit"}).format(oldest)} GMT${Date.now()-oldest>90*60000?" - showing last known numbers; refresh delayed.":"."}`;
---
<BaseLayout socialTitle="Volunteer at the Christmas Fayre | Ashley School" socialDescription="Help bring Narnia to life on Saturday 5 December. Choose an activity, join friends and pick a helper, setup or clear-up slot on JustSignup." image="/social/fayre-volunteering-2026-v2.jpg" imageAlt="Volunteer at the Fayre, Saturday 5 December 2026, 12:00 - 15:00 at Ashley School." imageWidth={1200} imageHeight={630} title="Christmas Fayre Volunteering" description="Help bring Narnia to life at Ashley School. Choose a Christmas Fayre activity and pick your volunteer slot on JustSignup." headerLogo="/brand/foa-logo-christmas-ivory.svg" footerLogo="/brand/foa-logo-christmas-ivory.svg" bodyClass="xmas-theme narnia-volunteering">
 <HomepageMobileIdentity label="The Friends of Ashley" logo="/brand/foa-logo-christmas-ivory.svg" />
 <div class="site-width fayre-volunteer">
  <NarniaHero event={event} eventPage={true} volunteerPage={true} snowfall={true}>
   <p slot="priority" class="fayre-volunteer__priority" data-most-help data-tokens-code={tokensCode} role="status" aria-live="polite" aria-atomic="true" data-availability-url={withBase("/fayre-availability.json")} data-availability-snapshot={JSON.stringify(snapshot)}><span data-help-content>{heroSummary===null?<><strong>Most help needed</strong><span>{`Tokens - ${tokensCount} ${tokensCount===1?"place":"places"} left`}</span></>:heroSummary}</span><span data-help-reserve aria-hidden="true"><b>Most help needed</b><i>Tokens - 160 places left</i></span></p>
  </NarniaHero>
  <FayreNavigation current="volunteer" />
  <section class="fayre-volunteer__intro" aria-label="Choose your volunteer activity">
   <p>Choose an activity below. Buttons open JustSignup in a new tab to pick your slot. Event helper slots are 30 minutes; setup and clear-up vary.</p>
  </section>
  <ul class="fayre-volunteer__grid" aria-label="Volunteer activities">
   {event.signupActivities.map((activity,index)=><li class:list={["fayre-volunteer__card",{"fayre-volunteer__card--full":availability[index]!.full}]} data-availability-code={activity.anchor} data-activity-name={activity.displayName??activity.name}>
    <div class="fayre-volunteer__heading"><h3>{activity.displayName??activity.name}</h3><p class="fayre-volunteer__availability" aria-live="polite" data-state={availability[index]!.state}>{availability[index]!.state==="ended"?"Finished":availability[index]!.count===null?<><span class="fayre-volunteer__slots fayre-volunteer__slots--count"></span><span class="fayre-volunteer__slots fayre-volunteer__slots--booked"></span></>:<><span class="fayre-volunteer__slots fayre-volunteer__slots--count"><strong class="fayre-volunteer__count">{availability[index]!.total?.capacity!=null?`${availability[index]!.count} / ${availability[index]!.total?.capacity}`:String(availability[index]!.count)}</strong><span class="fayre-volunteer__count-label">{availability[index]!.count===1&&availability[index]!.total?.capacity==null?" slot remaining":" slots remaining"}</span></span><span class="fayre-volunteer__slots fayre-volunteer__slots--booked"><strong class="fayre-volunteer__count fayre-volunteer__count--zero">Full</strong><span class="fayre-volunteer__count-label"> · 0 places left</span></span></>}</p></div>
    <p>{activity.description}</p>
    <dl class="fayre-volunteer__schedule">{activity.schedule.map(shift=><div><dt>{shift.label}</dt><dd>{shift.when.split('-').map((time,index)=><>{index>0 && ' - '}<span>{time}</span></>)}</dd></div>)}</dl>
    <a class="button fayre-volunteer__action" href={event.signupUrl+'#'+activity.anchor} target="_blank" rel="noopener noreferrer"><span class="cta-label">Choose a&nbsp;<span class="cta-tail">slot<span class="external-link-icon cta-icon" aria-hidden="true"><Fragment set:html={externalIcon}/></span></span><span class="visually-hidden"> for {activity.displayName??activity.name} (opens JustSignup in a new tab)</span></span></a>
    <span class="fayre-volunteer__booked">Fully booked</span>
   </li>)}
  </ul>
  <p class="fayre-volunteer__updated" data-availability-updated role="status" aria-live="polite">{updatedText}</p>
  <section class="fayre-volunteer__loan" aria-labelledby="loan-props">
   <div><h2 id="loan-props">Lend a little Narnia magic</h2><p>Have fairy lights, faux Christmas trees or props to lend? See the props and decor list on JustSignup for what's needed, drop-off details and return information.</p></div>
   <a class="button fayre-volunteer__action" href={event.signupUrl+'#'+event.loanSignupAnchor} target="_blank" rel="noopener noreferrer"><span class="cta-label">See the loan <span class="cta-tail">list<span class="external-link-icon cta-icon" aria-hidden="true"><Fragment set:html={externalIcon}/></span></span><span class="visually-hidden"> (opens JustSignup in a new tab)</span></span></a>
  </section>
  <div class="fayre-volunteer__closing">
   <section class="fayre-volunteer__contact" aria-labelledby="volunteer-questions"><h2 id="volunteer-questions">Questions about helping?</h2><a class="button fayre-volunteer__email" href={'mailto:'+event.contactEmail}><span class="cta-label">Email <span class="cta-tail">us<svg class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span></span><span class="visually-hidden"> (the Fayre team)</span></a></section>
  </div>
 </div>
 <FayrePageStyles />
</BaseLayout>
<script>
 import{remaining,totals,isSnapshot,retainValid,type Snapshot}from"../lib/fireworks-availability";
 // Seed with the build snapshot so a failed (or slow) first fetch never wipes the SSR counts.
 let snapshot:Snapshot=(()=>{
  try{
   const raw=document.querySelector<HTMLElement>("[data-availability-snapshot]")?.dataset.availabilitySnapshot;
   const parsed:unknown=raw?JSON.parse(raw):undefined;
   return isSnapshot(parsed)?parsed:{};
  }catch{return {};}
 })();
 const ended=()=>Date.now()>=Date.parse("2026-12-05T15:30:00+00:00");
 /** Render validated counts without repeated announcements. */
 function render(){
  const now=Date.now();
  const cards=[...document.querySelectorAll<HTMLElement>("[data-availability-code]")];
  for(const card of cards){
   const activity=snapshot.schema===1?snapshot.activities?.[card.dataset.availabilityCode!]:undefined;
   const total=ended()?{open:0,capacity:null}:totals(activity,now);
   const count=total===null?null:total.open;
   const output=card.querySelector<HTMLElement>(".fayre-volunteer__availability");
   if(!output)continue;
   const state=ended()?"ended":count===null?"unavailable":`${count}/${total?.capacity??""}`;
   card.classList.toggle("fayre-volunteer__card--full",!ended()&&count===0);
   const changed=output.dataset.state!==state;
   output.dataset.state=state;
   if(ended()){if(changed)output.textContent="Finished";}
   else if(count===null){if(changed)output.textContent="";}
   else{
    // The count and booked variants both occupy the line (stacked, taller wins),
    // so a stall filling or reopening never changes the heading's height (CI
    // caught the open text wrapping to two lines where the booked text is one).
    let openSlots=output.querySelector<HTMLElement>(".fayre-volunteer__slots--count");
    let bookedSlots=output.querySelector<HTMLElement>(".fayre-volunteer__slots--booked");
    if(!openSlots||!bookedSlots){
     openSlots=document.createElement("span");
     openSlots.className="fayre-volunteer__slots fayre-volunteer__slots--count";
     bookedSlots=document.createElement("span");
     bookedSlots.className="fayre-volunteer__slots fayre-volunteer__slots--booked";
     output.replaceChildren(openSlots,bookedSlots);
    }
    if(changed||!openSlots.firstChild){
     const number=document.createElement("strong");
     number.className="fayre-volunteer__count";
     number.textContent=total?.capacity!=null?`${count} / ${total.capacity}`:String(count);
     const label=document.createElement("span");
     label.className="fayre-volunteer__count-label";
     label.textContent=total?.capacity!=null||count!==1?" slots\u00A0remaining":" slot\u00A0remaining";
     openSlots.replaceChildren(number,label);
    }
    if(changed&&count===0){
     // Re-touch the now-visible booked variant so the live region announces it.
     const number=document.createElement("strong");
     number.className="fayre-volunteer__count fayre-volunteer__count--zero";
     number.textContent="Full";
     const zeroLabel=document.createElement("span");
     zeroLabel.className="fayre-volunteer__count-label";
     zeroLabel.textContent=" · 0 places left";
     bookedSlots.replaceChildren(number,zeroLabel);
    }
   }
  }
  const updated=document.querySelector<HTMLElement>("[data-availability-updated]");
  const times=cards.map(card=>snapshot.activities?.[card.dataset.availabilityCode!]?.checkedAt).filter((time):time is string=>!!time).map(Date.parse).filter(Number.isFinite);
  if(updated){
   const oldest=times.length?Math.min(...times):null;
   const text=ended()||oldest===null?"":`Last updated ${new Intl.DateTimeFormat("en-GB",{timeZone:"UTC",hour:"2-digit",minute:"2-digit"}).format(oldest)} GMT${now-oldest>90*60000?" - showing last known numbers; refresh delayed.":"."}`;
   if(updated.textContent!==text)updated.textContent=text;
  }
  const summary=document.querySelector<HTMLElement>("[data-help-content]");
  if(!summary)return;
  if(ended()){const text="Volunteering has finished. Thank you to everyone who helped.";if(summary.textContent!==text)summary.textContent=text;}
  else{
   const code=summary.closest<HTMLElement>("[data-tokens-code]")?.dataset.tokensCode;
   const count=remaining(snapshot.schema===1&&code?snapshot.activities?.[code]:undefined,now);
   if(count===null){const text="Check JustSignup for Tokens places.";if(summary.textContent!==text)summary.textContent=text;}
   else{
    const title=document.createElement("strong");title.textContent="Most help needed";
    const detail=document.createElement("span");detail.textContent=`Tokens - ${count}\u00A0${count===1?"place":"places"}\u00A0left`;
    if(summary.textContent!==title.textContent+detail.textContent)summary.replaceChildren(title,detail);
   }
  }
 }
 /** Reload our published file while retaining the last validated counts on failure. */
 async function load(){
  try{
   const url=document.querySelector<HTMLElement>("[data-availability-url]")?.dataset.availabilityUrl;
   if(!url)return;
   const response=await fetch(url,{cache:"no-cache"});
   if(!response.ok)throw new Error("Unavailable");
   const candidate:unknown=await response.json();
   if(!isSnapshot(candidate))throw new Error("Invalid snapshot");
   snapshot=retainValid(snapshot,candidate);
  }catch{/* Retain the last validated snapshot, with its original timestamps. */}
  render();
 }
 load();
 // Only recalculate time boundaries locally. Never poll JustSignup from visitors' browsers.
 window.setInterval(render,30000);
 // Refresh only our published file every 15 minutes, not the provider. Stop after the event.
 window.setInterval(()=>{if(!ended())load();},15*60000);
</script>
<style>
.fayre-volunteer{padding-bottom:2.5rem;color:#fff3d5}
.fayre-volunteer__brand{padding:1rem 4rem 1rem 0}
.fayre-volunteer__brand :global(.mobile-page-logo){display:block;width:3rem;height:3rem}
.fayre-volunteer__brand :global(img){width:100%;height:100%}
.fayre-volunteer :global(.narnia-landscape){max-width:none}
.fayre-volunteer :global(.narnia-landscape__art){width:100%;max-width:none;left:0;right:0;object-position:center center}
.fayre-volunteer :global(.narnia-landscape:before){display:block;background:linear-gradient(90deg,#10232c33,#10232cd9 35%,#10232cd9 64%,#10232c33)}
.fayre-volunteer__intro{width:100%;margin:1.25rem auto;line-height:1.65;text-align:center;font-size:.95rem}
.fayre-volunteer__intro p{margin:0}
.fayre-volunteer :global(.narnia-landscape__copy){min-height:0;padding:2rem 1.5rem;max-width:48rem}
.fayre-volunteer :global(.narnia-landscape h1){font-size:clamp(2rem,2.9vw,2.6rem);margin-bottom:.75rem}
.fayre-volunteer :global(.narnia-landscape h1 .hero-title-line){display:inline;color:inherit}
.fayre-volunteer :global(.narnia-landscape__subtitle){display:block;font-size:min(clamp(2.5rem,4.25vw,3.8rem),12.5vw);line-height:1.15;color:#edcb83;letter-spacing:.02em;margin-top:.15em}
.fayre-volunteer :global(.narnia-landscape__date){margin-bottom:.5rem}
@media(max-width:47.99rem){.fayre-volunteer :global(.narnia-landscape__subtitle){font-size:min(12.5vw,1.4rem)}}
@media(max-width:47.99rem){.fayre-volunteer :global(.narnia-landscape__art){position:absolute;inset:0;height:100%;aspect-ratio:auto;object-fit:cover}.fayre-volunteer :global(.narnia-landscape:before){display:block;background:linear-gradient(90deg,#10232ccc,#10232cdd 35%,#10232ccc)}.fayre-volunteer :global(.narnia-landscape h1){font-size:2rem!important}.fayre-volunteer :global(.narnia-landscape__copy){padding:1.25rem 1rem}}
.fayre-volunteer__grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,19rem),1fr));column-gap:1.25rem;row-gap:0}
.fayre-volunteer__card{position:relative;background:#173844;border:1px solid #b99a5b88;border-radius:.65rem;padding:1.5rem;display:grid;grid-template-rows:subgrid;grid-template-columns:minmax(0,1fr);grid-row:span 4;min-width:0;margin-bottom:1.25rem}
/* Under enlarged text, rem padding would squeeze the card content below the width of "slots remaining"; cap horizontal padding by viewport so the phrase always fits whole. */
/* Same for the page gutter: 2rem of rem gutter leaves too little room at 200% text. */
.site-width.fayre-volunteer{width:min(calc(100% - min(2rem,10vw)),var(--max-width))}
@media(min-width:64rem){.site-width.fayre-volunteer{width:min(calc(100% - min(3rem,10vw)),var(--max-width))}}
@media(max-width:47.99rem){.fayre-volunteer__card{padding-inline:min(1.5rem,5vw)}}
@media(max-width:23rem){.fayre-volunteer__card{padding-inline:min(1.5rem,2vw)}}
@container(max-width:15em){.fayre-volunteer__grid .fayre-volunteer__action .cta-icon.cta-icon{position:static!important;translate:none!important;display:inline-block;vertical-align:-.12em;margin-left:.35em!important}}
/* At very narrow widths the global icon-lane padding (calc(1.05em + 16px), !important) leaves the content box narrower than the word "Choose" at 200% text, so the overflowing word reaches the absolutely-positioned icon. Shrink the lane and tuck the icon closer to the edge so wrapped text stays clear of it. */
@media(max-width:23rem){.fayre-volunteer__grid .fayre-volunteer__action{padding-inline:1rem!important}.fayre-volunteer__grid .fayre-volunteer__action .cta-icon{right:8px!important}}
/* A full activity stays visible but muted, with its signup button removed (nothing left to book); the empty subgrid row keeps card heights aligned. Muting is by surface and border only: whole-card opacity would drop the status and schedule text below contrast. */
.fayre-volunteer__card--full{background:#10232c;border-color:#b99a5b3d}
/* A full activity swaps its signup button for a muted "Fully booked" note in the same subgrid row. Both elements always occupy the fourth row; the inactive one is visibility:hidden, so the row is the taller of the two in every state and a card gaining or losing the full state never moves the layout - even when enlarged text wraps the button label to two lines (Nick 20 Nov: the 52px phone shift; design 20 Nov: 42px at 375px/200%, clipping at 320px/200%). The note is its own class, not fayre-volunteer__action: other suites index that selector one-per-card. */
.fayre-volunteer__grid .fayre-volunteer__action,.fayre-volunteer__grid .fayre-volunteer__booked{grid-row:4;grid-column:1}
.fayre-volunteer__card.fayre-volunteer__card--full a.fayre-volunteer__action{visibility:hidden}
.fayre-volunteer__card.fayre-volunteer__card--full .fayre-volunteer__booked{visibility:visible}
.fayre-volunteer__card h3{font:500 min(1.6rem,13vw)/1.2 Georgia,serif;margin:0;color:#fff3d5;overflow-wrap:anywhere}
.fayre-volunteer__heading{display:flex;flex-direction:column;gap:.35rem;margin:0 0 1rem}
.fayre-volunteer__priority{display:grid;padding:0;margin:1.1rem 0 .4rem;font-size:.95rem;line-height:1.5;color:#f4ead1}
.fayre-volunteer__updated{font-size:.8rem;margin:0 0 1.25rem;color:#f3dfae}
.fayre-volunteer__updated:empty{display:none}
.fayre-volunteer__card .fayre-volunteer__availability{margin:0;font-size:.85rem;line-height:1.25;min-width:0;text-wrap:pretty;display:grid}
/* The count and booked variants share one grid cell; visibility (not display) keeps the hidden one placed, so the line is the taller of the two in every state and a stall filling never moves the card. Global because availability updates create these spans at runtime, where Astro's scoped attribute is absent. */
:global(.fayre-volunteer__slots){grid-area:1/1;min-width:0}
:global(.fayre-volunteer__slots--booked){visibility:hidden}
:global(.fayre-volunteer__card--full .fayre-volunteer__slots--count){visibility:hidden}
:global(.fayre-volunteer__card--full .fayre-volunteer__slots--booked){visibility:visible}
.fayre-volunteer__schedule{margin:0 0 1.5rem;border-top:1px solid #b99a5b55;font-size:.9rem;line-height:1.6}.fayre-volunteer__schedule>div{display:flex;justify-content:space-between;gap:.4rem 1rem;flex-wrap:wrap;padding-top:.5rem}.fayre-volunteer__schedule dt{color:#edcb83}.fayre-volunteer__schedule dd{margin:0;white-space:nowrap;color:#fff3d5}.fayre-volunteer__schedule dd span{white-space:nowrap}
.fayre-volunteer__card p{font-size:1rem;line-height:1.7;margin:0 0 1.5rem;color:#f4ead1}
.fayre-volunteer .fayre-volunteer__action{margin-top:auto;min-width:0;min-height:3.25rem;max-width:100%;white-space:normal;background:#742f3c;color:#fff5e2;border:1px solid #c9a65f;font-size:1rem;line-height:1.5;gap:.75rem;padding:.75rem 1rem;display:flex;flex-wrap:nowrap;justify-content:space-between;align-items:center;text-align:left}
.fayre-volunteer .fayre-volunteer__booked{display:flex;visibility:hidden;min-height:3.25rem;max-width:100%;padding:.75rem 1rem;font-size:1rem;line-height:1.5;justify-content:center;align-items:center;text-align:center;margin:0;background:transparent;color:#9fb8a4;border:1px solid #b99a5b3d;border-radius:999px}
.fayre-volunteer__action>span:first-child{min-width:0}.fayre-volunteer__action .external-link-icon{flex:0 0 auto;margin:0}
/* Activity slot buttons share the standard CTA geometry: the external icon sits in its own lane, so the label centres across the whole button. */
.fayre-volunteer__grid .fayre-volunteer__action{justify-content:center;text-align:center}
.fayre-volunteer__grid .fayre-volunteer__action .cta-label{text-align:center;overflow-wrap:normal!important;word-break:normal!important}
.fayre-volunteer__action :global(svg){flex-shrink:0;width:1.25em;height:1.25em}
.fayre-volunteer__action:focus-visible,.fayre-volunteer__closing a:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}
.fayre-volunteer__loan{margin-top:2rem;padding:1.5rem;border:1px solid #b99a5b88;border-radius:.65rem;background:#102d38;display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap}
.fayre-volunteer__loan>div{flex:1 1 28rem;min-width:0}
.fayre-volunteer__loan h2{margin:0 0 1rem}
.fayre-volunteer__loan p{margin:0;line-height:1.7}
.fayre-volunteer__closing{margin-top:1.5rem;display:grid;justify-items:center;gap:1.5rem}
.fayre-volunteer__closing .button{font-size:1rem;line-height:1.5;min-height:3.25rem;max-width:100%;padding:.75rem 1.25rem;white-space:normal;text-align:center;text-decoration:none;color:#fff3d5;border:1px solid #c9a65f}
.fayre-volunteer__contact{width:100%;border:1px solid #b99a5b88;border-radius:.65rem;background:#173844;padding:1.5rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem 2rem}
.fayre-volunteer__contact h2{margin:0;font:500 clamp(1.5rem,2.5vw,2rem)/1.2 Georgia,serif;color:#fff3d5}
.fayre-volunteer__closing .fayre-volunteer__email{background:#742f3c}
.fayre-volunteer__closing .button:hover{background:#954052}
.fayre-volunteer__closing .button:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}
.fayre-volunteer{container-type:inline-size}
@container(max-width:20em){.fayre-volunteer__card{padding:1rem;padding-inline:min(1rem,2vw)}.fayre-volunteer__contact{padding:1rem;padding-inline:min(1rem,5vw)}.fayre-volunteer__contact .button{width:100%}}

