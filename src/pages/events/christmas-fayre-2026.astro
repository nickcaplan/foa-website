.narnia-event .xmas-stage .xmas-donations__raffle{text-align:left;max-width:100ch}
.narnia-event .xmas-stage .xmas-points,.narnia-event .xmas-contact__copy p{text-align:left}
.narnia-event .xmas-stage .xmas-art-cta .button{width:100%;max-width:none;text-align:left;justify-content:flex-start}
.narnia-event .xmas-stage .xmas-art-cta{width:100%;max-width:none}
