---
import "../styles/christmas-home.css";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FundraisingSummary from "../components/FundraisingSummary.astro";
import MobilePageHeading from "../components/MobilePageHeading.astro";
import { withBase } from "../lib/urls";
import { ukDateKey } from "../lib/event-visibility";
import { ordinalDateFormatter, formatEventTimeRange } from "../lib/dates";
const events = await getCollection("events");
const event = events.find(({ id }) => id === "christmas-fayre-2026")?.data;
if (!event?.contactEmail) throw new Error("Homepage Christmas Fayre content is missing");
const latestNewsletter = (await getCollection("newsletters"))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.published!.getTime() - a.data.published!.getTime())[0]?.data;
const appeal = (await getCollection("fundraising")).find(({ id }) => id === "current-appeal")?.data;
if (!appeal) throw new Error("Homepage fundraising content is missing");
const eventDate = ordinalDateFormatter({ weekday: "long", timeZone: "Europe/London" })(event.start);
const titleParts = event.title.trim().split(/\s+/);
const titleEnd = titleParts.pop()!;
const titleLead = titleParts.join(" ");
const mailto = `mailto:${event.contactEmail}?subject=${encodeURIComponent(`Helping at the ${event.title}`)}`;
---
   <BaseLayout title="The Friends of Ashley" description="The Friends of Ashley, the PTA for Ashley C of E Primary School in Walton-on-Thames." bodyClass="homepage">
  <section class="hero">
    <div class="site-width hero-grid">
      <div class="hero-event">
       <div class="hero-copy">
          <MobilePageHeading>
            <h1>{titleLead && `${titleLead} `}<em>{titleEnd}.</em></h1>
          </MobilePageHeading>
          <p class="hero-when"><span class="hero-fact"><svg class="hero-fact-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg><strong>{eventDate}<span class="relative-date relative-date--inline" data-event-date={ukDateKey(event.start)} hidden></span></strong></span><span class="hero-fact"><svg class="hero-fact-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg><strong>{event.location}</strong></span></p><p class="christmas-home-admission"><strong>{formatEventTimeRange(event.start, event.end)}</strong><span>{event.entry}</span></p></div>
       <div class="hero-side">

        <article class="event-feature event-feature--poster christmas-home-art" aria-label="Christmas Fayre artwork and details">
          <img class="christmas-home-wreath" src={withBase("/brand/foa-logo-christmas-home.webp")} alt="The Friends of Ashley Christmas wreath" width="1200" height="630" fetchpriority="high" />
          <span class="sponsor-ribbon"><img src={withBase("/sponsors/martin-flashman.jpeg")} alt="Martin Flashman and Co" width="225" height="33" loading="lazy" /></span>
        <div class="hero-actions"><a class="button button--amber button--large" href={mailto}><span class="cta-label">Email the <span class="cta-word">organiser<span class="cta-tail">s<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a>
          <a class="button button--primary button--large christmas-home-details" href={withBase(event.path!)}><span class="cta-label">Event <span class="cta-word">detail<span class="cta-tail">s<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span></span></span></span></a>
        </div>
        </article>
       </div>
      </div>
     <div class="quick-list hero-links">
     {latestNewsletter && <a class="quick-row" href={withBase("/newsletter/")}><span><h3>Read the latest newsletter</h3><p>{latestNewsletter.title}</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>}
     <a class="quick-row" href={withBase("/get-involved/")}><span><h3>Get involved</h3><p>Roles, meetings, class reps and ways to help.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
     </div>
    </div>
  </section>
  <section class="fundraising-update" aria-labelledby="fundraising-update-title">
    <div class="site-width">
      <FundraisingSummary appeal={appeal} />
    </div>
  </section>
</BaseLayout>


<script>
  import { syncRelativeDates } from "../lib/event-visibility";
  const update = () => syncRelativeDates();
  update();
  window.setInterval(update, 60000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) update(); });
</script>
