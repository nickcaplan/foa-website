---
import MailIcon from "../components/MailIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Contact Us" description="Contact The Friends of Ashley through the shared committee inbox or Google Form." bodyClass="contact-page">
  <PageHero eyebrow="Contact The FOA" title="Start with the shared inbox." intro="Questions, ideas and offers of help are welcome." />
  <section class="content-section content-section--compact content-section--desktop-snug"><div class="site-width split-layout"><div><h2 class="editorial-heading">Get in touch</h2><p class="section-copy">Use the shared address for The FOA so the right committee member can respond.</p><a class="button button--primary" href="mailto:thefriendsofashley@gmail.com"><span class="cta-label">Email The Friends of <span class="cta-tail">Ashley<MailIcon /></span></span></a></div><article class="info-card"><h2>Send us a message</h2><p>Use our Google Form if you would prefer to send your question online.</p><a class="button button--secondary" href="https://forms.gle/xCJ7mhcNS6CoVK37A" target="_blank" rel="noopener noreferrer"><span class="cta-label">Open the contact <span class="cta-word">for<span class="cta-tail">m<span class="external-link-icon cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></span></a></article></div></section>
</BaseLayout>

<style>
  :global(.contact-page .content-section) {
    container: contact-details / inline-size;
  }

  .split-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @container contact-details (min-width: 48em) {
    .split-layout {
      grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
