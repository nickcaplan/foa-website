</style>
<style is:inline>
/* The poster is a centred invitation; information below stays left-aligned. */
.narnia-event .xmas-stage .narnia-landscape__copy{text-align:center;align-items:center;margin-inline:auto}
.narnia-event .xmas-stage .narnia-landscape h1{text-align:center!important}
