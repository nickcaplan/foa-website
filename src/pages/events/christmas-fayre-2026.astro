</style>

<style is:inline>
.xmas-stalls-cta,.xmas-art-cta{margin:2rem auto;text-align:center}.xmas-stalls-cta .button,.xmas-art-cta .button{display:inline-flex;align-items:center;justify-content:center;gap:1rem;width:min(100%,22rem);min-height:3.5rem;padding:.8rem 1.5rem;background:#742f3c;border:1px solid #c9a65f;color:#fff5e2;font-size:1rem;line-height:1.5}.xmas-stalls-cta .button:focus-visible,.xmas-art-cta .button:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}.xmas-stalls-cta svg,.xmas-art-cta svg{flex:none}.xmas-art-cta .button{white-space:normal;text-align:left}.xmas-art-cta .cta-label,.xmas-art-cta .cta-tail{display:inline;white-space:normal;min-width:0}.xmas-art-cta .cta-tail svg{display:inline-block;vertical-align:middle;margin-left:.5rem}
</style>

<style is:inline>
@media(min-width:64rem){.narnia-event .xmas-section__lead{max-width:none}}
</style>

<style is:inline>
@media(max-width:47.99rem){
.narnia-event .xmas-hero{padding-bottom:0}
.narnia-event .xmas-hero+.xmas-section{padding-top:.75rem}
.narnia-event .xmas-hero+.xmas-section h2{margin-top:0}
}
</style>

<style is:inline>
@media(max-width:63.99rem){
