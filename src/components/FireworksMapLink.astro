---
interface Props { href: string; label: string; }
const { href, label } = Astro.props;
const words = label.trim().split(/\s+/);
const lastWord = words.pop() ?? "";
const prefix = words.join(" ");
const characters = Array.from(lastWord);
const lastCharacter = characters.pop();
---
<a class="fw-map-link" href={href} target="_blank" rel="noopener noreferrer">{prefix && <><span class="fw-map-link__label">{prefix}</span>{" "}</>}<span class="cta-word"><span class="fw-map-link__label">{characters.join("")}</span><span class="cta-tail"><span class="fw-map-link__label">{lastCharacter}</span><span class="external-link-icon" aria-hidden="true"><svg data-cta-arrow="external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></span></span><span class="visually-hidden"> (opens in a new tab)</span></a>
