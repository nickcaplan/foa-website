---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { withBase } from "../../lib/urls";
---
<BaseLayout title="Fireworks on the Field has finished" description="The 2026 Fireworks on the Field event has finished. Find current Friends of Ashley events.">
  <div class="retired-event-heading"><PageHero eyebrow="Past event" title="Fireworks on the Field has finished" intro="Thank you to everyone who came along and helped make the evening possible." /></div>
  <section class="content-section content-section--snug"><div class="site-width">
    <p>The 2026 event information, ticket sales and volunteer sign-ups have been retired.</p>
    <p><a class="button button--primary" href={withBase("/events/christmas-fayre-2026/")}>Christmas Fayre details</a></p>
    <p><a href={withBase("/whats-on/")}>See what's on at Ashley</a></p>
  </div></section>
</BaseLayout>

<style>
  @media (max-width: 63.99rem) {
    .retired-event-heading :global(.mobile-page-heading) { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .retired-event-heading :global(.mobile-page-heading-brand) { width: min(128px, 100%); }
    .retired-event-heading :global(.mobile-page-heading-copy) { width: 100%; padding-top: 0; }
    .retired-event-heading :global(.mobile-page-heading-copy h1) { font-size: clamp(1rem, 9cqi, 2.65rem); overflow-wrap: normal; }
  }
</style>
