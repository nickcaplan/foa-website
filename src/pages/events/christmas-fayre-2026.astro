}

@media(min-width:64rem) and (max-width:79.99rem){.narnia-event .menu-toggle{top:calc(1rem + var(--introduction-logo-size)*.45 - 1.5rem)}}
</style>


<style is:inline>
.fayre-leads{margin:0}.narnia-event .fayre-leads h2{margin:0 0 .75rem;font:700 .85rem/1.4 var(--font-body,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase;color:#edcb83;text-align:left}.narnia-event .fayre-leads h2:after{display:none}.fayre-leads__grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.fayre-leads__card{margin:0;max-width:100%;padding:1.15rem;text-align:center;font:700 1.15rem/1.4 var(--font-display);color:var(--xm-gold-light);border:1px solid var(--xm-gold);border-radius:var(--radius-sm);background:linear-gradient(#17503ab3,#0f3a27b3);box-shadow:inset 0 0 0 4px #08241ae6,inset 0 0 0 5px var(--xm-gold-dim)}
@media(max-width:47.99rem){.fayre-leads__grid{grid-template-columns:1fr}}

</style>

<style is:inline>
