---
import NarniaHero from "../components/NarniaHero.astro";
import HomepageMobileIdentity from "../components/HomepageMobileIdentity.astro";
import EventVisibilityInit from "../components/EventVisibilityInit.astro";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FundraisingSummary from "../components/FundraisingSummary.astro";
import { withBase } from "../lib/urls";
const events = await getCollection("events");
const christmasPreview = Astro.props.christmasPreview === true;
const event = events.find(({ id }) => id === "christmas-fayre-2026")?.data;
if (!event?.contactEmail) throw new Error("Homepage Christmas Fayre content is missing");
const latestNewsletter = (await getCollection("newsletters"))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.published!.getTime() - a.data.published!.getTime())[0]?.data;
const appeal = (await getCollection("fundraising")).find(({ id }) => id === "current-appeal")?.data;
if (!appeal) throw new Error("Homepage fundraising content is missing");
---
   <BaseLayout title="The Friends of Ashley" description="The Friends of Ashley, the PTA for Ashley C of E Primary School in Walton-on-Thames." bodyClass="homepage" noindex={christmasPreview} homepage={christmasPreview}>

  <HomepageMobileIdentity />
  <section class="hero">
    <div class="site-width hero-grid">
      <NarniaHero event={event} homepage={true} />
     <div class="quick-list hero-links">
     {latestNewsletter && <a class="quick-row" href={withBase("/newsletter/")}><span><h3>Read the latest newsletter</h3><p>{latestNewsletter.title}</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>}
     <a class="quick-row" href={withBase("/get-involved/")}><span><h3>Get involved</h3><p>Roles, meetings, class reps and ways to help.</p></span><span class="quick-arrow" aria-hidden="true">&rarr;</span></a>
     </div>
    </div>
  </section>
  <noscript><div class="site-width"><p>Homepage event shown as of the last site update. <a href={withBase(event.path!)}>Christmas Fayre details</a> are always available.</p></div></noscript>
  <section class="fundraising-update" aria-labelledby="fundraising-update-title">
    <div class="site-width">
      <FundraisingSummary appeal={appeal} />
    </div>
  </section>
  {christmasPreview && <div class="site-width"><p><strong>Christmas homepage preview only.</strong> The live homepage remains unchanged pending approval and deployment.</p></div>}
  <EventVisibilityInit />
</BaseLayout>


<script>
  import { syncEventVisibility, syncRelativeDates } from "../lib/event-visibility";
  const update = () => { syncEventVisibility(); syncRelativeDates(); };
  update();
  window.setInterval(update, 60000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) update(); });
  window.addEventListener("pageshow", update);
</script>

<style is:inline>@media(min-width:64rem){.homepage .hero-links{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:2rem;max-width:none;width:100%}}</style>

<style is:inline>
@media(min-width:64rem) and (max-width:79.99rem){.homepage .menu-toggle{top:calc(1rem + (var(--introduction-logo-size) - 3rem)/2)}}
</style>
