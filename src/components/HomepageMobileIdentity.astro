---
import { withBase } from "../lib/urls";
---
<div class="homepage-mobile-identity" aria-label="The Friends of Ashley homepage">
  <img src={withBase("/brand/foa-logo-ivory.svg")} alt="" width="44" height="44" />
  <p><span class="homepage-mobile-identity-prefix">The Friends of</span> Ashley</p>
</div>
<style is:inline>
  .homepage-mobile-identity { display: none; }
  @media (max-width: 63.99rem) {
    .homepage-mobile-identity { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; padding: 1rem calc(3rem + 16px) 1rem 0; border-bottom: 1px solid var(--line); position: relative; margin-inline: auto; width: calc(100% - 2rem); color: var(--heading); }
    .homepage-mobile-identity img { width: 3rem; height: 3rem; flex: none; }
    .homepage-mobile-identity p { margin: 0; font-family: Georgia, serif; font-size: 1.5rem; font-weight: 700; line-height: 1.15; overflow-wrap: normal; word-break: normal; flex: 1; min-width: min(5.5em, 100%); }
  }
  @media (max-width: 63.99rem) {
    .homepage-mobile-identity-prefix { display: block; font-family: var(--font-body, system-ui, sans-serif); font-size: .52em; line-height: 1.5; letter-spacing: .09em; text-transform: uppercase; }
    .homepage-mobile-identity::after { content: ""; position: absolute; width: 3rem; height: 3px; background: var(--amber); bottom: -2px; left: 0; }
  }
  @media (max-width: 20rem) {
    .homepage-mobile-identity { padding-inline-end: 64px; }
  }
</style>
