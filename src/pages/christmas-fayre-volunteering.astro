---
import {getEntry} from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NarniaHero from '../components/NarniaHero.astro';
import PageLogo from '../components/PageLogo.astro';
import {withBase} from '../lib/urls';
import '../styles/christmas.css';
const entry=await getEntry('events','christmas-fayre-2026');
const event=entry?.data;
if(!event?.signupActivities || !event.signupUrl || !event.path) throw new Error('Fayre volunteering content is missing');
const externalIcon='<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/></svg>';
---
<BaseLayout title="Christmas Fayre Volunteering" description="Help bring Narnia to life at Ashley School. Choose a Christmas Fayre activity and pick your volunteer slot on JustSignup." image="/brand/foa-logo-christmas-og.png" headerLogo="/brand/foa-logo-christmas-ivory.svg" footerLogo="/brand/foa-logo-christmas-ivory.svg" bodyClass="xmas-theme narnia-volunteering">
 <div class="site-width fayre-volunteer">
  <div class="fayre-volunteer__brand"><PageLogo logo="/brand/foa-logo-christmas-ivory.svg" /></div>
  <NarniaHero event={event} eventPage={true} volunteerPage={true}/>
  <section class="fayre-volunteer__intro" aria-labelledby="choose-activity">
   <p class="fayre-volunteer__eyebrow">Step through the wardrobe</p>
   <h2 id="choose-activity">Help bring Narnia to life</h2>
   <p>Everyone across the school can join in anywhere. Bring a friend and choose an activity you'll enjoy. No experience needed.</p>
   <p>Event helper slots are 30 minutes, leaving time to enjoy the Fayre with your family. Setup and clear-up times vary by activity.</p>
   <p class="fayre-volunteer__tip">Sign-up buttons open the matching activity on JustSignup in a new tab. Choose your time and check current availability there.</p>
  </section>
  <ul class="fayre-volunteer__grid" aria-label="Volunteer activities">
   {event.signupActivities.map((activity,index)=><li class="fayre-volunteer__card">
    <span class="fayre-volunteer__number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>
    <h3>{activity.name}</h3>
    <p>{activity.description}</p>
    <dl class="fayre-volunteer__schedule">{activity.schedule.map(shift=><div><dt>{shift.label}</dt><dd>{shift.when}</dd></div>)}</dl>
    <a class="button fayre-volunteer__action" href={event.signupUrl+'#'+activity.anchor} target="_blank" rel="noopener noreferrer"><span>Choose a slot<span class="visually-hidden"> for {activity.name} (opens JustSignup in a new tab)</span></span><span class="external-link-icon" aria-hidden="true"><Fragment set:html={externalIcon}/></span></a>
   </li>)}
  </ul>
  <section class="fayre-volunteer__loan" aria-labelledby="loan-props">
   <div><h2 id="loan-props">Lend a little Narnia magic</h2><p>Have fairy lights, faux Christmas trees or props to lend? See the props and decor list on JustSignup for what's needed, drop-off details and return information.</p></div>
   <a class="button fayre-volunteer__action" href={event.signupUrl+'#'+event.loanSignupAnchor} target="_blank" rel="noopener noreferrer"><span>See the loan list<span class="visually-hidden"> (opens JustSignup in a new tab)</span></span><span class="external-link-icon" aria-hidden="true"><Fragment set:html={externalIcon}/></span></a>
  </section>
  <div class="fayre-volunteer__closing"><a href={withBase(event.path)}>Back to Christmas Fayre details</a><p>Questions about helping? <a href={'mailto:'+event.contactEmail}>Email the Fayre team</a>.</p></div>
 </div>
</BaseLayout>
<style>
.fayre-volunteer{padding-bottom:2.5rem;color:#fff3d5}
.fayre-volunteer__brand{padding:1rem 4rem 1rem 0}
.fayre-volunteer__brand :global(.mobile-page-logo){display:block;width:3rem;height:3rem}
.fayre-volunteer__brand :global(img){width:100%;height:100%}
.fayre-volunteer__intro{max-width:44rem;margin:2.5rem auto;text-align:center}
.fayre-volunteer__intro h2,.fayre-volunteer__loan h2{font-family:Georgia,serif;font-weight:500;color:#fff3d5;line-height:1.2;font-size:clamp(1.75rem,3vw,2.5rem)}
.fayre-volunteer__eyebrow{color:#edcb83;text-transform:uppercase;font-size:.8rem;letter-spacing:.15em;font-weight:700}
.fayre-volunteer__intro p{line-height:1.75}
.fayre-volunteer__tip{padding:1rem;border:1px solid #b99a5b66;border-radius:.5rem;background:#fff3d509;font-size:.95rem}
.fayre-volunteer__grid{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,19rem),1fr));gap:1.25rem}
.fayre-volunteer__card{position:relative;background:#173844;border:1px solid #b99a5b88;border-radius:.65rem;padding:1.5rem;display:flex;flex-direction:column;min-width:0}
.fayre-volunteer__number{font:italic 1.25rem Georgia,serif;color:#edcb83;margin-bottom:1rem}
.fayre-volunteer__card h3{font:500 1.6rem/1.2 Georgia,serif;margin:0 0 1rem;color:#fff3d5;overflow-wrap:anywhere}
.fayre-volunteer__schedule{margin:0 0 1.5rem;border-top:1px solid #b99a5b55;font-size:.9rem;line-height:1.6}.fayre-volunteer__schedule>div{display:flex;justify-content:space-between;gap:.4rem 1rem;flex-wrap:wrap;padding-top:.5rem}.fayre-volunteer__schedule dt{color:#edcb83}.fayre-volunteer__schedule dd{margin:0;white-space:nowrap;color:#fff3d5}
.fayre-volunteer__card p{font-size:1rem;line-height:1.7;margin:0 0 1.5rem;color:#f4ead1}
.fayre-volunteer .fayre-volunteer__action{margin-top:auto;min-width:0;min-height:3.25rem;max-width:100%;white-space:normal;background:#742f3c;color:#fff5e2;border:1px solid #c9a65f;font-size:1rem;line-height:1.5;gap:.75rem;padding:.75rem 1rem;display:flex;flex-wrap:nowrap;justify-content:space-between;align-items:center;text-align:left}
.fayre-volunteer__action>span:first-child{min-width:0}.fayre-volunteer__action .external-link-icon{flex:0 0 auto;margin:0}
.fayre-volunteer__action :global(svg){flex-shrink:0;width:1.25em;height:1.25em}
.fayre-volunteer__action:focus-visible,.fayre-volunteer__closing a:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}
.fayre-volunteer__loan{margin-top:2rem;padding:1.5rem;border:1px solid #b99a5b88;border-radius:.65rem;background:#102d38;display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap}
.fayre-volunteer__loan>div{flex:1 1 28rem;min-width:0}
.fayre-volunteer__loan h2{margin:0 0 1rem}
.fayre-volunteer__loan p{margin:0;line-height:1.7}
.fayre-volunteer__closing{text-align:center;margin-top:2rem;line-height:1.7}
.fayre-volunteer__closing a{color:#edcb83;text-decoration:underline;text-underline-offset:.2em;overflow-wrap:anywhere}
@media(min-width:80rem){.fayre-volunteer__brand{display:none}}
</style>
