---
import MobilePageHeading from './MobilePageHeading.astro';
import {withBase} from '../lib/urls';
import {ordinalDateFormatter,formatEventTimeRange} from '../lib/dates';
const {event,eventPage=false}=Astro.props;
const date=ordinalDateFormatter({weekday:'long',timeZone:'Europe/London'})(event.start);
---
<section class="narnia-landscape" aria-label="Christmas Fayre">
<img class="narnia-landscape__art" src={withBase('/brand/narnia-hero-landscape.webp')} width="2048" height="1152" alt="" loading="eager" fetchpriority="high" />
<div class="narnia-landscape__copy">
<MobilePageHeading><h1 id="xmas-title">Christmas <em>Fayre</em></h1></MobilePageHeading>
<p class="narnia-landscape__date">{date} · {formatEventTimeRange(event.start,event.end)}</p>
<p class="narnia-landscape__venue">{event.location}<br />{event.entry}</p>
<a class="button" href={eventPage ? '#sign-up' : withBase(event.path)+'#sign-up'}>Sign up to help <span aria-hidden="true">→</span></a>
</div>
</section>
<style is:inline>.narnia-landscape{grid-column:1/-1;position:relative;isolation:isolate;width:100%;max-width:72rem;margin:0 auto 1rem;border:1px solid #b99a5b;overflow:hidden;border-radius:10px;background:#102d38;box-shadow:0 12px 30px #102d3825;color:#fff3d5}.narnia-landscape__art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.narnia-landscape:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#10232c18,#10232cc9 35%,#10232cbf 63%,#10232c18);z-index:-1}.narnia-landscape__copy{text-align:center;padding:5rem 1.5rem;max-width:42rem;margin:auto;min-height:34rem;display:flex;flex-direction:column;justify-content:center;align-items:center}.narnia-landscape h1{text-transform:none!important;overflow-wrap:normal!important;word-break:normal!important;font:500 clamp(2rem,4.5vw,4.5rem)/1.12 Georgia,serif;color:#fff3d5!important;margin:0 0 1.25rem;letter-spacing:-.025em}.narnia-landscape h1 em{display:block;color:#edcb83;font-weight:400}.narnia-landscape__date{font-size:1.05rem;font-weight:700;line-height:1.7;margin:0 0 1rem;color:#fff3d5}.narnia-landscape__venue{font-size:1rem;line-height:1.7;margin:0 0 1.75rem;color:#f4ead1}.narnia-landscape .button{background:#742f3c;color:#fff5e2;border:1px solid #c9a65f;font-size:1rem;padding:.8rem 1.5rem;white-space:normal;line-height:1.5}.narnia-landscape .button span{margin-left:1rem}.narnia-landscape .mobile-page-heading-brand{display:none!important}.narnia-landscape .mobile-page-heading,.narnia-landscape .mobile-page-heading-copy{display:block!important;width:100%!important;padding:0!important;margin:0!important}.narnia-landscape .mobile-page-heading:before{display:none!important}@media(max-width:47.99rem){.narnia-landscape__art{position:relative;display:block;height:auto;aspect-ratio:16/9;object-fit:cover}.narnia-landscape:before{display:none}.narnia-landscape__copy{min-height:0;padding:1.75rem 1.25rem 2rem}.narnia-landscape h1{font-size:min(3rem,10vw)!important}.narnia-landscape h1 em{display:inline}.narnia-landscape__date{font-size:1rem}.narnia-landscape .button{width:100%;max-width:22rem}}</style>
