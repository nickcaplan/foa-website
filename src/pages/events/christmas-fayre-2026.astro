.narnia-event .narnia-landscape:before{background:linear-gradient(90deg,#10232c33,#10232cdd 35%,#10232cdd 62%,#10232c88)}
}
</style>

<style is:inline>
/* The poster and information share outer edges; columns keep prose readable. */
.narnia-event .xmas-stage .xmas-section h2,
.narnia-event .xmas-stage .xmas-section__lead,
.narnia-event .xmas-stage .xmas-notes h3,
.narnia-event .xmas-stage .fayre-leads__card{text-align:left}
.narnia-event .xmas-stage .xmas-section h2::after{margin-left:0;background:linear-gradient(90deg,var(--xm-gold),transparent)}
.narnia-event .xmas-stage .xmas-section__lead{max-width:none;margin-inline:0}
.narnia-event .xmas-stage .xmas-notes{max-width:none;margin-inline:0}
.narnia-event .xmas-stage .xmas-stalls-cta,
.narnia-event .xmas-stage .xmas-art-cta{justify-content:flex-start;text-align:left;margin:1.5rem 0}
