---
import FayreNavigation from "../../components/FayreNavigation.astro";
import EventVisibilityInit from "../../components/EventVisibilityInit.astro";
import HomepageMobileIdentity from "../../components/HomepageMobileIdentity.astro";
import NarniaHero from "../../components/NarniaHero.astro";
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChristmasTrees from "../../components/ChristmasTrees.astro";
import "../../styles/christmas.css";
import FayrePageStyles from '../../components/FayrePageStyles.astro';
import { withBase } from "../../lib/urls";

const entry = await getEntry("events", "christmas-fayre-2026");
if (!entry?.data.helpAreas || !entry.data.contactEmail) throw new Error("Christmas Fayre content is missing");
const event = entry.data;
const helpAreas = event.helpAreas!;
if (!event.lead) throw new Error("Christmas Fayre leads are missing");
const leads = event.lead.split(/ and (?=[^()]*\()/).map((lead) => lead.replace(/\s*\([^)]*\)/g, "").trim());
const email = event.contactEmail!;
// Every time on the day comes from the newsletter; the opening and closing rows come from the event's own start and end.
const clock = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/London" });
const timeline = [
  { time: event.start, label: "Fayre opens", detail: "Entry £2, under 12s go free. Tickets on the door." },
  ...(event.schedule ?? []),
  ...(event.end ? [{ time: event.end, label: "Fayre closes" }] : []),
];
const mailto = `mailto:${email}?subject=${encodeURIComponent("Helping at the Christmas Fayre")}`;

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  description: "A magical Christmas afternoon for the Ashley school community, organised by The Friends of Ashley.",
  startDate: event.start.toISOString(),
  ...(event.end ? { endDate: event.end.toISOString() } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: { "@type": "Place", name: event.location, address: { "@type": "PostalAddress", addressLocality: "Walton-on-Thames", addressCountry: "GB" } },
  organizer: { "@type": "Organization", name: "The Friends of Ashley", url: new URL(withBase("/"), Astro.site).href },
};
---
<BaseLayout socialTitle="Christmas Fayre | Saturday 5 December 2026 | Ashley School" socialDescription="Step into Narnia at Ashley School, Saturday 5 December, 12:00 - 15:00. Games, crafts, food and festive fun. Entry \u00a32; under 12s free." image="/social/christmas-fayre-2026-v1.jpg" imageAlt="Christmas Fayre, Saturday 5 December 2026, 12:00 - 15:00 at Ashley School, with the Narnia-inspired woodland artwork." imageWidth={1200} imageHeight={630} title={event.title} description="Help at the Ashley Christmas Fayre: join a slot with your friends, no experience needed." headerLogo="/brand/foa-logo-christmas-ivory.svg" footerLogo="/brand/foa-logo-christmas-ivory.svg" bodyClass="xmas-theme narnia-event" preloadImage="/brand/narnia-hero-landscape.avif">
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <HomepageMobileIdentity label="The Friends of Ashley" logo="/brand/foa-logo-christmas-ivory.svg" />
  <div class="xmas-stage">
    <section class="xmas-hero" aria-labelledby="xmas-title">
      <div class="site-width fayre-hero-shell">
        <NarniaHero event={event} eventPage={true} snowfall={true} />
      </div>
    </section>

    <div class="site-width fayre-hero-shell"><FayreNavigation current="event" /></div>

    <div class="site-width xmas-upcoming"><div class="xmas-upcoming__grid">

    <section class="xmas-section xmas-timeline" aria-labelledby="xmas-timeline-title">
      <div>
        <h2 id="xmas-timeline-title">On the day</h2>
        <ol class="schedule">
          {timeline.map((item) => (
            <li>
              <time datetime={item.time.toISOString()}>{clock.format(item.time)}{"end" in item && item.end ? `\u00a0- ${clock.format(item.end)}` : ""}</time>
              <span><strong>{item.label}</strong>{item.detail && <p>{item.detail}</p>}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="xmas-section" aria-labelledby="xmas-art-title">
      <div>
        <h2 id="xmas-art-title">Art Competition</h2>
        <p class="xmas-section__lead">Show us your lions, witches and snow queens! The theme is Narnia, and any medium is welcome. Deadline: Monday 30th November.</p>
        <p class="xmas-actions xmas-art-cta"><a class="button button--large xmas-art-cta__button" href={withBase('/christmas-fayre-art-competition/')}><span class="cta-label">Enter the <span class="cta-tail">Art&nbsp;Competition<svg data-cta-arrow="forward" class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></a></p>
      </div>
    </section>

    <section class="xmas-section" aria-labelledby="xmas-raffle-title">
      <div>
        <h2 id="xmas-raffle-title">Christmas Raffle</h2>
        <p class="xmas-section__lead">Our online Christmas raffle opens on Monday 30th November and closes on Saturday 5th December, in the evening after the Fayre.</p>
        <p class="xmas-actions xmas-art-cta"><a class="button button--large xmas-art-cta__button" href="https://www.zeffy.com/en-GB/ticketing/the-friends-of-ashleys-christmas-raffle--2026" target="_blank" rel="noopener noreferrer"><span class="cta-label">Buy <span class="cta-tail">raffle&nbsp;tickets<svg data-cta-arrow="external" class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></span><span class="visually-hidden"> (opens in a new tab)</span></a></p>
      </div>
    </section>

    <section class="xmas-section xmas-help-section" aria-labelledby="xmas-areas-title">
      <div>
        <h2 id="xmas-areas-title">Where we need friendly faces</h2>
        <div class="xmas-help-layout"><div class="xmas-help-copy">
        <p class="xmas-section__lead">Instead of assigning stalls to year groups, anyone across the school can join in anywhere. Sign up for a slot alongside your friends and help with whatever you’re best at. Join the helpers at these activities (pairs welcome!):</p>
        <p class="xmas-section__lead xmas-help-roles" data-fayre-help-roles>{helpAreas.map(area => area.name).join('; ')}.</p>
        <p class="xmas-actions xmas-stalls-cta"><a class="button button--large xmas-stalls-cta__button" href={withBase(event.volunteeringPath ?? '/christmas-fayre-volunteering/')}><span class="cta-label"><span class="cta-tail">Volunteer<svg data-cta-arrow="forward" class="cta-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></span></a></p>
        </div></div>
      </div>
    </section>
    </div></div>

    <div class="site-width xmas-followup">
    <section class="xmas-section xmas-section--last" aria-labelledby="xmas-contact-title">
      <div class="xmas-narrow">
        <div class="xmas-frame xmas-contact">
          <div class="xmas-contact__copy">
            <div class="xmas-contact__heading">
            <h2 id="xmas-contact-title">Get in touch</h2>
            <p class="xmas-contact__leads"><strong>Led by</strong> {leads.map((lead)=><span class="xmas-contact__lead-person">{lead}{" "}</span>)}</p>
            </div>
            <p>Email the Christmas Fayre team or chat with the team in the playground if you have any questions about helping. Use the sign-up button above to explore the volunteer activities, then choose your slot on JustSignup.</p>
            <p class="xmas-actions"><a class="button button--amber button--large" href={mailto}><span class="cta-label">Email the <span class="cta-tail">Fayre&nbsp;team<span class="cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span></span></span></a></p>
          </div>
          <ChristmasTrees />
        </div>
      </div>
    </section>
    </div>
  </div>
  <EventVisibilityInit />
  <script>
    import { syncEventVisibility } from "../../lib/event-visibility";
    syncEventVisibility();
    setInterval(syncEventVisibility, 60000);
    document.addEventListener("visibilitychange", () => !document.hidden && syncEventVisibility());
  </script>
 <FayrePageStyles />
<style is:global>
/* "On the day" timeline: the Fireworks schedule markup in the Fayre theme. */
.narnia-event .xmas-timeline .schedule{margin:.8rem 0 2rem;padding:0;list-style:none;max-width:40rem}
.narnia-event .xmas-timeline .schedule li{--tl-x:calc(10rem + .9rem);position:relative;display:grid;grid-template-columns:10rem minmax(0,1fr);align-items:baseline;gap:.25rem 1.8rem;padding:0 0 1.6rem;border:0}
.narnia-event .xmas-timeline .schedule li:last-child{padding-bottom:0;border:0}
.narnia-event .xmas-timeline .schedule li::before{content:"";position:absolute;left:calc(var(--tl-x) - 1px);top:calc(.78rem + 7px);bottom:calc(7px - .78rem);width:2px;background:var(--xm-gold-dim)}
.narnia-event .xmas-timeline .schedule li:last-child::before{display:none}
.narnia-event .xmas-timeline .schedule li::after{content:"";position:absolute;left:calc(var(--tl-x) - 7px);top:calc(.78rem - 7px);width:14px;height:14px;box-sizing:border-box;border:2px solid var(--xm-gold);border-radius:50%}
.narnia-event .xmas-timeline .schedule li:first-child::after,.narnia-event .xmas-timeline .schedule li:last-child::after{background:var(--xm-gold)}
.narnia-event .xmas-timeline .schedule time{text-align:right;padding-right:.45rem;color:var(--xm-gold-light);font-family:var(--font-display);font-size:1.3rem;font-weight:600;line-height:1.2;white-space:nowrap;font-variant-numeric:tabular-nums}
.narnia-event .xmas-timeline .schedule li>span{padding-left:.45rem}
.narnia-event .xmas-timeline .schedule strong{display:block;color:var(--xm-cream);font-size:1.05rem;line-height:1.35}
.narnia-event .xmas-timeline .schedule p{margin:.15rem 0 0;color:var(--xm-cream);opacity:.85;line-height:1.5}
/* Narrow rows: the line moves to the left edge and the time sits above the label. */
@container(max-width:30em){.narnia-event .xmas-timeline .schedule li{--tl-x:7px;grid-template-columns:minmax(0,1fr);padding-left:22px}.narnia-event .xmas-timeline .schedule time{text-align:left;white-space:normal;padding-right:0}.narnia-event .xmas-timeline .schedule li>span{padding-left:0}.narnia-event .xmas-timeline .schedule strong{font-size:1rem}}
</style>
</BaseLayout>

<style is:global>
.narnia-event .xmas-stage .site-width{width:min(calc(100% - 2rem),var(--max-width))}@media(min-width:64rem){.narnia-event .xmas-stage .site-width{width:min(calc(100% - 3rem),var(--max-width))}}.narnia-event .narnia-landscape{max-width:none}.narnia-event-details{max-width:52rem;margin:2rem auto 0;text-align:center}
</style>

<style is:global>
@media(min-width:64rem){
.narnia-event-details{max-width:none;text-align:left}
}
</style>

<style is:global>
.narnia-event .narnia-landscape__copy{min-height:0;padding:2rem 1.5rem;max-width:48rem}
.narnia-event .narnia-landscape h1{font-size:clamp(2rem,3.5vw,3rem);margin-bottom:.75rem}
.narnia-event .narnia-landscape h1 .hero-title-line{display:inline}
.narnia-event .narnia-landscape__date{margin-bottom:.5rem}
.narnia-event .narnia-landscape__venue{margin-bottom:1rem}
@media(max-width:47.99rem){
.narnia-event .narnia-landscape__art{position:absolute;inset:0;height:100%;aspect-ratio:auto;object-fit:cover}
.narnia-event .narnia-landscape:before{display:block;background:linear-gradient(90deg,#10232ccc,#10232cdd 35%,#10232ccc)}
.narnia-event .narnia-landscape h1{font-size:2rem!important}
.narnia-event .narnia-landscape__copy{padding:1.25rem 1rem}
}
</style>

<style is:global>
.narnia-event .narnia-landscape__art{width:160%;max-width:none;left:0;right:auto;object-position:left center}
.narnia-event .narnia-landscape:before{display:block;background:linear-gradient(90deg,#10232c44,#10232cdd 42%,#10232ce6)}
@media(max-width:47.99rem){.narnia-event .narnia-landscape__art{width:180%;object-position:left center}}
</style>

<style is:global>
.xmas-stalls-cta,.xmas-art-cta{margin:2rem auto;text-align:center}.xmas-stalls-cta .button,.xmas-art-cta .button{display:inline-flex;align-items:center;justify-content:center;gap:min(1rem,3vw);width:min(100%,22rem);min-height:3.5rem;padding:.8rem min(1.5rem,5vw);background:#742f3c;border:1px solid #c9a65f;color:#fff5e2;font-size:1rem;line-height:1.5}.xmas-stalls-cta .button:focus-visible,.xmas-art-cta .button:focus-visible{outline:3px solid #fff3d5;outline-offset:4px}.xmas-stalls-cta svg,.xmas-art-cta svg{flex:none}.xmas-art-cta .button{white-space:normal;text-align:left}.xmas-art-cta a.button.button{padding:.8rem min(1.5rem,5vw)!important}@media(max-width:47.99rem){main .xmas-art-cta.xmas-art-cta.xmas-art-cta a.button.button.button.button{padding-inline:calc(1.05em + 18px)!important}}.xmas-art-cta a.button .cta-label,.xmas-stalls-cta a.button .cta-label,.xmas-actions a.button--amber .cta-label{display:inline;white-space:normal;min-width:0;overflow-wrap:normal!important;word-break:normal!important}.xmas-contact .xmas-actions a.button--amber{width:min(100%,22rem);justify-content:center}main .xmas-contact .xmas-actions a.button--amber.button--amber:has(.cta-icon){padding-inline:calc(1.3em + 18px)!important}@media(max-width:47.99rem){.xmas-contact{padding-inline:12px!important}}@media(max-width:25.99rem){main .xmas-art-cta.xmas-art-cta .button,main .xmas-stalls-cta.xmas-stalls-cta .button,main .xmas-contact .xmas-actions a.button--amber.button--amber{font-size:min(1.05rem,6vw)!important}}@media(min-width:26rem) and (max-width:27.99rem){main .xmas-art-cta.xmas-art-cta .button,main .xmas-stalls-cta.xmas-stalls-cta .button,main .xmas-contact .xmas-actions a.button--amber.button--amber{font-size:min(1.05rem,6.5vw)!important}}@media(min-width:28rem) and (max-width:39.99rem){main .xmas-art-cta.xmas-art-cta .button{font-size:min(1.05rem,6.5vw)!important}}@media(min-width:48rem) and (max-width:63.99rem){main .xmas-contact .xmas-actions a.button--amber.button--amber{font-size:min(1.05rem,3.4vw)!important}}.xmas-art-cta .cta-tail,.xmas-stalls-cta .cta-tail,.xmas-actions .button--amber .cta-tail{display:inline;white-space:nowrap}.xmas-art-cta .cta-tail svg{display:inline-block;vertical-align:middle;margin-left:.5rem}
</style>

<style is:global>
@media(min-width:64rem){.narnia-event .xmas-section__lead{max-width:none}}
</style>

<style is:global>
@media(max-width:47.99rem){
.narnia-event .xmas-hero{padding-bottom:0}
.narnia-event .xmas-hero+.xmas-section{padding-top:.75rem}
.narnia-event .xmas-hero+.xmas-section h2{margin-top:0}
}
</style>

<style is:global>
@media(max-width:63.99rem){
.narnia-event .xmas-hero>.site-width{padding-top:0}
}

@media(min-width:64rem) and (max-width:79.99rem){.narnia-event .menu-toggle{top:calc(1rem + var(--introduction-logo-size)*.45 - calc(var(--menu-toggle-size) / 2))}}
</style>


<style is:global>
.fayre-leads{margin:0}.narnia-event .fayre-leads h2{margin:0 0 .75rem;font:700 .85rem/1.4 var(--font-body,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase;color:#edcb83;text-align:left}.narnia-event .fayre-leads h2:after{display:none}.fayre-leads__grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.fayre-leads__card{margin:0;max-width:100%;padding:1.15rem;text-align:center;font:700 1.15rem/1.4 var(--font-display);color:var(--xm-gold-light);border:1px solid var(--xm-gold);border-radius:var(--radius-sm);background:linear-gradient(#17503ab3,#0f3a27b3);box-shadow:inset 0 0 0 4px #08241ae6,inset 0 0 0 5px var(--xm-gold-dim)}
@media(max-width:47.99rem){.fayre-leads__grid{grid-template-columns:1fr}}

</style>

<style is:global>
.narnia-event .xmas-help-roles{max-width:none;margin-top:.75rem;line-height:1.65;text-wrap:pretty}
</style>

<style is:global>
.narnia-event .xmas-stage .xmas-narrow{max-width:none}
</style>

<style is:global>
@media(min-width:48rem){
.narnia-event .narnia-landscape__art{width:100%;left:0;right:0;object-position:center center}
.narnia-event .narnia-landscape:before{background:linear-gradient(90deg,#10232c33,#10232cdd 35%,#10232cdd 62%,#10232c88)}
}
</style>

<style is:global>
/* The poster and information share outer edges; columns keep prose readable. */
.narnia-event .xmas-stage .xmas-section h2,
.narnia-event .xmas-stage .xmas-section__lead,
.narnia-event .xmas-stage .xmas-notes h3,
.narnia-event .xmas-stage .fayre-leads__card{text-align:left}
.narnia-event .xmas-stage .xmas-section h2::after{margin-left:0;background:linear-gradient(90deg,var(--xm-gold),transparent)}
.narnia-event .xmas-stage .xmas-section__lead{max-width:none;margin-inline:0}
.narnia-event .xmas-stage .xmas-notes{max-width:none;margin-inline:0}
.narnia-event .xmas-stage .xmas-stalls-cta,
.narnia-event .xmas-stage .xmas-art-cta{justify-content:flex-start;text-align:left;margin:1.5rem 0}
.narnia-event .xmas-stage .narnia-event-details{margin-top:1rem}
.narnia-event .xmas-stage .xmas-section{padding-block:1.5rem}
.narnia-event .xmas-stage .xmas-section--last{padding-bottom:2.5rem}
.narnia-event .xmas-stage .button .cta-label{white-space:normal;overflow-wrap:anywhere;min-width:0}
.narnia-event .xmas-stage .xmas-stalls-cta .cta-tail{white-space:nowrap}
</style>



<style is:global>
.narnia-event .xmas-upcoming,.narnia-event .xmas-section>.site-width{container-type:inline-size}
.narnia-event .xmas-help-layout{display:block}.narnia-event .xmas-help-section>div{max-width:48rem;margin-inline:auto}.narnia-event .xmas-help-copy{max-width:none}
.narnia-event .xmas-help-layout .xmas-notes{margin-top:0}
.narnia-event .xmas-help-copy .xmas-section__lead:first-child{margin-top:.8rem}
.narnia-event .xmas-contact__copy{max-width:72ch}
@container(min-width:56em){
 .narnia-event .xmas-upcoming__grid>section[aria-labelledby="xmas-art-title"]>div{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:0 2rem;align-items:center}
 .narnia-event #xmas-art-title{grid-column:1 / -1}
 .narnia-event .xmas-art-cta{margin:0!important}
 .narnia-event .xmas-help-layout .xmas-notes{padding-top:.8rem;border-top:0}
}
</style>

<style is:global>
@container(min-width:56em){
 .narnia-event .xmas-upcoming__grid>section[aria-labelledby="xmas-art-title"]>div{grid-template-columns:minmax(0,62ch) max-content;justify-content:start}
}
</style>

<style is:global>
.narnia-event .xmas-stage{container-type:inline-size}
/* Fayre-only wide shell: shared edges without stretching reading lines. */
.narnia-event .xmas-stage .site-width{width:min(calc(100% - 2rem),100rem)}
@media(min-width:64rem){.narnia-event .xmas-stage .site-width{width:min(calc(100% - 4rem),100rem)}}
.narnia-event .xmas-stage .narnia-landscape:before{background:linear-gradient(90deg,#10232cf2,#10232cd9 35%,#10232c55 70%,#10232c33)}
.narnia-event .xmas-stage .narnia-landscape__copy{text-align:left;align-items:flex-start;margin-inline:0;padding-inline:1.5rem;max-width:48rem}
.narnia-event .xmas-stage .narnia-landscape h1{text-align:left!important}
.narnia-event .xmas-stage .narnia-landscape__footer{justify-content:flex-start;padding-inline:1.5rem}
.narnia-event .xmas-stage .narnia-landscape__footer .sponsor-ribbon img{margin-inline:0}
.narnia-event .xmas-stage .xmas-section__lead{max-width:72ch}
.narnia-event .xmas-stage .xmas-help-roles{max-width:72ch}
.narnia-event .xmas-stage .xmas-points,.narnia-event .xmas-contact__copy p{text-align:left}
.narnia-event .xmas-stage .xmas-art-cta .button{width:100%;max-width:none;text-align:left;justify-content:flex-start}
.narnia-event .xmas-stage .xmas-art-cta{width:100%;max-width:none}
.narnia-event .xmas-followup{container-type:inline-size;display:grid;gap:1.5rem;padding-block:1.5rem 2.5rem}
.narnia-event .xmas-followup .narnia-event-details{margin:0;max-width:none;text-align:left}
.narnia-event .xmas-followup .xmas-section{padding:0;min-width:0}
.narnia-event .xmas-followup .xmas-contact{height:100%;padding:1.5rem}
.narnia-event .xmas-followup .xmas-contact__copy{max-width:65ch}
.narnia-event .xmas-followup .xmas-contact .xmas-actions{text-align:left;justify-content:flex-start}
.narnia-event .xmas-followup .fayre-leads__grid{grid-template-columns:1fr}
@container(min-width:56em){
 .narnia-event .xmas-upcoming__grid>section[aria-labelledby="xmas-art-title"]>div{grid-template-columns:minmax(0,1.5fr) minmax(18rem,1fr);gap:0 2.5rem;justify-content:stretch}
 .narnia-event .xmas-followup:has(.narnia-event-details){grid-template-columns:minmax(0,1fr) minmax(0,2fr);align-items:start}
}
@media(max-width:47.99rem){
